<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" Width="500" Height="320"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        x:Class="ASE.SaveListingWindow"
        Title="Save listing…">

        <StackPanel Margin="20">
                <Border Classes="card">
                        <StackPanel Spacing="10">
                                <TextBlock Classes="section" Text="Segment"/>
                                <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="20">
                                        <RadioButton Grid.Column="0" x:Name="rbSegment" GroupName="grpSegment" IsChecked="True" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBlock VerticalAlignment="Center" Margin="0,0,10,0">From</TextBlock>
                                                <TextBox x:Name="txtFrom" Width="100" Text="0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                <TextBlock VerticalAlignment="Center" Margin="0,0,10,0">To</TextBlock>
                                                <TextBox x:Name="txtTo" Width="100" Text="0" />
                                        </StackPanel>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="20">
                                        <RadioButton Grid.Column="0" x:Name="rbWrapPc" GroupName="grpSegment" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBlock VerticalAlignment="Center" Margin="0,0,10,0">Wrap PC</TextBlock>
                                                <TextBox x:Name="txtWrapPc" Width="100" Text="500" />
                                                <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" Opacity="0.7">instructions</TextBlock>
                                        </StackPanel>
                                </Grid>

                                <TextBlock FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                                           Text="From/To are hexadecimal addresses. Wrap PC keeps the current PC at the middle of the listing."/>

                                <ToggleSwitch x:Name="tglRegisters" Content="Include registers"/>

                        </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="Save…" Classes="accent" Width="80" HorizontalContentAlignment="Center" Click="OnSaveClick" />
                        <Button Content="Cancel" Width="80" HorizontalContentAlignment="Center" Click="OnCancelClick" />
                </StackPanel>
        </StackPanel>

</Window>
