<Project Sdk="Microsoft.NET.Sdk">

	<!-- Absent on clean clones: the app then falls back to user-supplied values. -->
	<Import Project="Local.props" Condition="Exists('Local.props')" />

	<PropertyGroup>
    <!-- WinExe, so Windows starts the emulator without opening a console window of its own.
         Launched from a console it still logs there and still takes its arguments: ConsoleHost
         attaches to the parent's console at the top of Main. Outside Windows the two values are
         the same thing (only the PE header distinguishes the subsystems). -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
	<LangVersion>latest</LangVersion>
    <PublishAot>false</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Platforms>AnyCPU;x64</Platforms>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>SsDevApp</_Parameter1>
			<_Parameter2>$(SsDevApp)</_Parameter2>
		</AssemblyAttribute>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>SsDevId</_Parameter1>
			<_Parameter2>$(SsDevId)</_Parameter2>
		</AssemblyAttribute>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>SsDevPassword</_Parameter1>
			<_Parameter2>$(SsDevPassword)</_Parameter2>
		</AssemblyAttribute>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>SsDevDebugPassword</_Parameter1>
			<_Parameter2>$(SsDevDebugPassword)</_Parameter2>
		</AssemblyAttribute>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>CryptoSeed</_Parameter1>
			<_Parameter2>$(CryptoSeed)</_Parameter2>
		</AssemblyAttribute>
	</ItemGroup>

	<PropertyGroup>
		<Major>1</Major>
		<Minor>15</Minor>
	</PropertyGroup>

	<PropertyGroup>
		<Product>Atari System Emulator</Product>
		<Company>The Bit Culture</Company>
		<Description>Atari System Emulator</Description>
		<Copyright>Copyright © 2026 The Bit Culture</Copyright>

		<AssemblyVersion>$(Major).$(Minor)</AssemblyVersion>
		<FileVersion>$(Major).$(Minor)</FileVersion>
		<Version>$(Major).$(Minor)</Version>

		<IncludeSourceRevisionInInformationalVersion>true</IncludeSourceRevisionInInformationalVersion>

		<ApplicationIcon>icon.ico</ApplicationIcon>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>full</DebugType>
  </PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
		<DebugType>full</DebugType>
	</PropertyGroup>
  <ItemGroup>
    <Content Include="icon.ico" />
  </ItemGroup>

	<ItemGroup>
		<AvaloniaResource Include="Assets/**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.1.5" />
		<PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
		<PackageReference Include="ReactiveUI.Avalonia" Version="12.1.6" />
		<PackageReference Include="LibVLCSharp" Version="3.10.2" />
		<PackageReference Include="sdl2" Version="2.0.5" />
		<PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
		<PackageReference Include="Svg.Controls.Skia.Avalonia" Version="12.0.0.17" />
		<PackageReference Include="TinyDialogsNet" Version="2.0.0" />
		<!-- libvlc binaries for game video previews; on macOS/Linux VLC must be installed system-wide -->
		<PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" Condition="'$(OS)' == 'Windows_NT'" />
  </ItemGroup>

	<ItemGroup>
	  <Compile Update="DebugWindow.axaml.cs">
	    <DependentUpon>DebugWindow.axaml</DependentUpon>
	  </Compile>
	</ItemGroup>

	<!--
		Native library selection by RID. The natives live in native/<rid>/
		(see native/README.md). ONLY the RID being built is copied:
		- publish -r <rid>  → RuntimeIdentifier
		- build/run without -r  → this machine's RID (NETCoreSdkPortableRuntimeIdentifier)
		The RID is normalised to os+architecture to tolerate variants
		(win10-x64, linux-musl-arm64, ..).
	-->
	<PropertyGroup>
		<_AseRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</_AseRid>
		<_AseRid Condition="'$(_AseRid)' == ''">$(NETCoreSdkPortableRuntimeIdentifier)</_AseRid>

		<AseNativeOs Condition="$(_AseRid.StartsWith('win'))">win</AseNativeOs>
		<AseNativeOs Condition="$(_AseRid.StartsWith('osx'))">osx</AseNativeOs>
		<AseNativeOs Condition="$(_AseRid.StartsWith('linux'))">linux</AseNativeOs>

		<AseNativeArch Condition="$(_AseRid.EndsWith('arm64'))">arm64</AseNativeArch>
		<AseNativeArch Condition="'$(AseNativeArch)' == '' and $(_AseRid.EndsWith('x64'))">x64</AseNativeArch>

		<AseNativeRid>$(AseNativeOs)-$(AseNativeArch)</AseNativeRid>
	</PropertyGroup>

	<!--
		libVLC (VideoLAN.LibVLC.Windows) copies ALL THREE Windows architectures to the output
		as soon as Platform is AnyCPU: 102 MB of win-x64, 99 of win-x86 and 83 of win-arm64.
		Only the one matching the published RID is of any use, and the other two are 182 MB
		in the zip and in the installer. The package lets these properties override it (see
		its .targets, which evaluates them with Condition="== ''"), so setting them here is
		enough — they must come AFTER the block computing AseNativeArch, which they read.
	-->
	<PropertyGroup Condition="'$(AseNativeOs)' == 'win'">
		<VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
		<VlcWindowsX64Enabled>$([System.String]::Copy('$(AseNativeArch)').Equals('x64'))</VlcWindowsX64Enabled>
		<VlcWindowsArm64Enabled>$([System.String]::Copy('$(AseNativeArch)').Equals('arm64'))</VlcWindowsArm64Enabled>
	</PropertyGroup>

	<!--
		Single-file publishing: every file the project copies (the natives below, libVLC's
		DLLs and plugins, the JSON catalogues, the ROM) goes NEXT TO the executable, never into
		the bundle. SDK 10 got there on its own: whatever the bundler refused as native code
		was copied beside the exe. SDK 11 (11.0.100-rc.2) treats any .dll nobody marked as
		an assembly to bundle, the bundler still refuses it, and the file ends up in neither
		place: moira.dll, SDL2.dll, mt32emu-2.dll and 323 libVLC files vanished from the
		publish folder with only a NETSDK1236 warning naming them. Marking every None/Content
		item excluded says it explicitly. Nothing changes on SDK 10, since no packaging
		script sets IncludeNativeLibrariesForSelfExtract or IncludeAllContentForSelfExtract.
		An item definition also reaches the Content items libVLC's .targets creates inside
		a target of its own.
	-->
	<ItemDefinitionGroup>
		<None>
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
		</None>
		<Content>
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
		</Content>
	</ItemDefinitionGroup>

	<ItemGroup>
		<!-- EmuTOS (GPL) travels with its notice and licence text, which say where its source is. -->
		<None Update="emutos.rom">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="emutos.txt">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="emutos-license.txt">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="GameMenus.json">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>

		<!-- ASEHD boot driver (tools/asehd, assembled with vasm — see build.cmd there).
		     Two flat binaries: the boot sector and the resident driver. Embedded so a
		     created hard disk image comes out bootable with nothing to install on the ST. -->
		<EmbeddedResource Include="Resources/ASEHD.BOT" Condition="Exists('Resources/ASEHD.BOT')">
			<LogicalName>ASE.Resources.ASEHD.BOT</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="Resources/ASEHD.SYS" Condition="Exists('Resources/ASEHD.SYS')">
			<LogicalName>ASE.Resources.ASEHD.SYS</LogicalName>
		</EmbeddedResource>

		<!-- SMAA lookup tables (Jimenez et al., MIT licence): the precomputed area texture
		     (160x560, two bytes per texel) and the search texture (64x16, one byte), taken as-is
		     from the reference implementation. GLControl expands them to RGBA at init; without
		     them the SMAA anti-aliasing mode is reported unavailable and the picture is drawn
		     unfiltered. -->
		<EmbeddedResource Include="Resources/SMAA_AreaTex.bin" Condition="Exists('Resources/SMAA_AreaTex.bin')">
			<LogicalName>ASE.Resources.SMAA_AreaTex.bin</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="Resources/SMAA_SearchTex.bin" Condition="Exists('Resources/SMAA_SearchTex.bin')">
			<LogicalName>ASE.Resources.SMAA_SearchTex.bin</LogicalName>
		</EmbeddedResource>

		<!-- Moira -->
		<None Update="native/$(AseNativeRid)/moira.dll" Condition="'$(AseNativeOs)' == 'win'">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Link>moira.dll</Link>
		</None>
		<None Update="native/$(AseNativeRid)/moira.dylib" Condition="'$(AseNativeOs)' == 'osx'">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Link>moira.dylib</Link>
		</None>
		<None Update="native/$(AseNativeRid)/moira.so" Condition="'$(AseNativeOs)' == 'linux'">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Link>moira.so</Link>
		</None>

		<!-- SDL2: Windows and macOS only; on Linux the distribution's is used -->
		<None Update="native/$(AseNativeRid)/SDL2.dll" Condition="'$(AseNativeOs)' == 'win'">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Link>SDL2.dll</Link>
		</None>
		<None Update="native/$(AseNativeRid)/libSDL2.dylib" Condition="'$(AseNativeOs)' == 'osx'">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Link>libSDL2.dylib</Link>
		</None>
		
		<None Update="native/$(AseNativeRid)/mt32emu-2.dll" Condition="'$(AseNativeOs)' == 'win'">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Link>mt32emu-2.dll</Link>
		</None>
		<None Update="native/$(AseNativeRid)/libmt32emu.2.dylib" Condition="'$(AseNativeOs)' == 'osx'">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Link>libmt32emu.2.dylib</Link>
		</None>
		<None Update="native/$(AseNativeRid)/libmt32emu.so.2" Condition="'$(AseNativeOs)' == 'linux'">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Link>libmt32emu.so.2</Link>
		</None>
		<None Update="native/$(AseNativeRid)/libtinyfiledialogs.so" Condition="'$(AseNativeOs)' == 'linux' and '$(AseNativeArch)' == 'arm64'">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Link>libtinyfiledialogs.so</Link>
		</None>
		<None Update="PPAdaptedGames.json">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		
	</ItemGroup>

	<!-- Warn instead of failing: clean clones must still build. -->
	<Target Name="WarnMissingSsCredentials" BeforeTargets="Build" Condition="'$(SsDevId)' == ''">
		<Warning Text="ScreenScraper credentials not configured. Copy Local.props.template to Local.props. Scraping will be disabled in this build." />
	</Target>

	<ItemGroup>
		<UpToDateCheckInput Include="Local.props" Condition="Exists('Local.props')" />
	</ItemGroup>

</Project>
