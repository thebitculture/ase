<Project Sdk="Microsoft.NET.Sdk">

	<!-- Absent on clean clones: the app then falls back to user-supplied values. -->
	<Import Project="Local.props" Condition="Exists('Local.props')" />

	<PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
	<LangVersion>latest</LangVersion>
    <PublishAot>false</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Platforms>AnyCPU;x64</Platforms>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>SsDevApp</_Parameter1>
			<_Parameter2>$(SsDevApp)</_Parameter2>
		</AssemblyAttribute>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>SsDevId</_Parameter1>
			<_Parameter2>$(SsDevId)</_Parameter2>
		</AssemblyAttribute>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>SsDevPassword</_Parameter1>
			<_Parameter2>$(SsDevPassword)</_Parameter2>
		</AssemblyAttribute>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>SsDevDebugPassword</_Parameter1>
			<_Parameter2>$(SsDevDebugPassword)</_Parameter2>
		</AssemblyAttribute>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>CryptoSeed</_Parameter1>
			<_Parameter2>$(CryptoSeed)</_Parameter2>
		</AssemblyAttribute>
	</ItemGroup>

	<PropertyGroup>
		<Major>1</Major>
		<Minor>10</Minor>
	</PropertyGroup>

	<PropertyGroup>
		<Product>Atari System Emulator</Product>
		<Company>The Bit Culture</Company>
		<Description>Atari System Emulator</Description>
		<Copyright>Copyright © 2026 The Bit Culture</Copyright>

		<AssemblyVersion>$(Major).$(Minor)</AssemblyVersion>
		<FileVersion>$(Major).$(Minor)</FileVersion>
		<Version>$(Major).$(Minor)</Version>

		<IncludeSourceRevisionInInformationalVersion>true</IncludeSourceRevisionInInformationalVersion>

		<ApplicationIcon>icon.ico</ApplicationIcon>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>full</DebugType>
  </PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
		<DebugType>full</DebugType>
	</PropertyGroup>
  <ItemGroup>
    <Content Include="icon.ico" />
  </ItemGroup>

	<ItemGroup>
		<AvaloniaResource Include="Assets/**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.1.1" />
		<PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
		<PackageReference Include="ReactiveUI.Avalonia" Version="12.1.1" />
		<PackageReference Include="LibVLCSharp" Version="3.10.1" />
		<PackageReference Include="sdl2" Version="2.0.5" />
		<PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
		<PackageReference Include="Svg.Controls.Skia.Avalonia" Version="12.0.0.15" />
		<PackageReference Include="TinyDialogsNet" Version="2.0.0" />
		<!-- libvlc binaries for game video previews; on macOS/Linux VLC must be installed system-wide -->
		<PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" Condition="'$(OS)' == 'Windows_NT'" />
  </ItemGroup>

	<ItemGroup>
	  <Compile Update="DebugWindow.axaml.cs">
	    <DependentUpon>DebugWindow.axaml</DependentUpon>
	  </Compile>
	</ItemGroup>

	<!--
		Selección de librería nativa por RID. Las nativas viven en native/<rid>/
		(ver native/README.md). Se copia SOLO la del RID con el que se compila:
		- publish -r <rid>  → RuntimeIdentifier
		- build/run sin -r  → RID del equipo (NETCoreSdkPortableRuntimeIdentifier)
		El RID se normaliza a so+arquitectura para tolerar variantes
		(win10-x64, linux-musl-arm64, …).
	-->
	<PropertyGroup>
		<_AseRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</_AseRid>
		<_AseRid Condition="'$(_AseRid)' == ''">$(NETCoreSdkPortableRuntimeIdentifier)</_AseRid>

		<AseNativeOs Condition="$(_AseRid.StartsWith('win'))">win</AseNativeOs>
		<AseNativeOs Condition="$(_AseRid.StartsWith('osx'))">osx</AseNativeOs>
		<AseNativeOs Condition="$(_AseRid.StartsWith('linux'))">linux</AseNativeOs>

		<AseNativeArch Condition="$(_AseRid.EndsWith('arm64'))">arm64</AseNativeArch>
		<AseNativeArch Condition="'$(AseNativeArch)' == '' and $(_AseRid.EndsWith('x64'))">x64</AseNativeArch>

		<AseNativeRid>$(AseNativeOs)-$(AseNativeArch)</AseNativeRid>
	</PropertyGroup>

	<ItemGroup>
		<None Update="GameMenus.json">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>

		<!-- Moira -->
		<None Update="native/$(AseNativeRid)/moira.dll" Condition="'$(AseNativeOs)' == 'win'">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Link>moira.dll</Link>
		</None>
		<None Update="native/$(AseNativeRid)/moira.dylib" Condition="'$(AseNativeOs)' == 'osx'">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Link>moira.dylib</Link>
		</None>
		<None Update="native/$(AseNativeRid)/moira.so" Condition="'$(AseNativeOs)' == 'linux'">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Link>moira.so</Link>
		</None>

		<!-- SDL2: solo Windows y macOS; en Linux se usa el de la distribución -->
		<None Update="native/$(AseNativeRid)/SDL2.dll" Condition="'$(AseNativeOs)' == 'win'">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Link>SDL2.dll</Link>
		</None>
		<None Update="native/$(AseNativeRid)/libSDL2.dylib" Condition="'$(AseNativeOs)' == 'osx'">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Link>libSDL2.dylib</Link>
		</None>
		
		<None Update="native/$(AseNativeRid)/mt32emu-2.dll" Condition="'$(AseNativeOs)' == 'win'">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Link>mt32emu-2.dll</Link>
		</None>
		<None Update="native/$(AseNativeRid)/libmt32emu.2.dylib" Condition="'$(AseNativeOs)' == 'osx'">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Link>libmt32emu.2.dylib</Link>
		</None>
		<None Update="native/$(AseNativeRid)/libmt32emu.so.2" Condition="'$(AseNativeOs)' == 'linux'">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Link>libmt32emu.so.2</Link>
		</None>
		<None Update="native/$(AseNativeRid)/libtinyfiledialogs.so" Condition="'$(AseNativeOs)' == 'linux' and '$(AseNativeArch)' == 'arm64'">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Link>libtinyfiledialogs.so</Link>
		</None>
		
	</ItemGroup>

	<!-- Warn instead of failing: clean clones must still build. -->
	<Target Name="WarnMissingSsCredentials" BeforeTargets="Build" Condition="'$(SsDevId)' == ''">
		<Warning Text="ScreenScraper credentials not configured. Copy Local.props.template to Local.props. Scraping will be disabled in this build." />
	</Target>

	<ItemGroup>
		<UpToDateCheckInput Include="Local.props" Condition="Exists('Local.props')" />
	</ItemGroup>

</Project>
