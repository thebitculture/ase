<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:svg="clr-namespace:Avalonia.Svg;assembly=Svg.Controls.Avalonia"
		xmlns:local="clr-namespace:ASE"
		x:Class="ASE.MainWindow"
		Title="Atari System Emulator"
		WindowStartupLocation="CenterScreen"
		UseLayoutRounding="True"
		DragDrop.AllowDrop="True"
		Background="#1A1A1A"
		Width="800" Height="600">

		<Window.Resources>
			<ResourceDictionary>

				<ControlTheme x:Key="MenuSectionHeaderTheme"
							  TargetType="MenuItem"
							  BasedOn="{StaticResource {x:Type MenuItem}}">
					<Setter Property="IsHitTestVisible" Value="False" />
					<Setter Property="Focusable" Value="False" />
					<Setter Property="IsTabStop" Value="False" />
					<Setter Property="FontSize" Value="10" />
					<Setter Property="FontWeight" Value="SemiBold" />
					<Setter Property="Opacity" Value="0.65" />
					<Setter Property="Padding" Value="12,10,12,4" />
					<Setter Property="Template">
						<ControlTemplate>
							<Border
								Padding="{TemplateBinding Padding}"
								Background="Transparent">

								<ContentPresenter
									Content="{TemplateBinding Header}"
									ContentTemplate="{TemplateBinding HeaderTemplate}"
									HorizontalAlignment="Left"
									VerticalAlignment="Center"
									RecognizesAccessKey="False" />

							</Border>
						</ControlTemplate>
					</Setter>

				</ControlTheme>

			</ResourceDictionary>
		</Window.Resources>

	<DockPanel LastChildFill="True">
		<Menu DockPanel.Dock="Top" Name="MainMenu" Background="Transparent">

			<MenuItem Header="_File">

				<MenuItem Header="DRIVE A:" Theme="{StaticResource MenuSectionHeaderTheme}" />
				<MenuItem Header="_Open disk image…" Click="OnOpenImageClick">
					<MenuItem.Icon>
						<Svg Path="avares://ASE/Assets/Icons/disk.svg" Width="16" Height="16"/>
					</MenuItem.Icon>
				</MenuItem>
				<MenuItem Header="_Change disk from ZIP…" Click="OnChangeDiskClick" Name="ItemMenuChangeDisk" IsEnabled="False">
					<MenuItem.Icon>
						<Svg Path="avares://ASE/Assets/Icons/zip.svg" Width="16" Height="16"/>
					</MenuItem.Icon>
				</MenuItem>
				<MenuItem Header="_Eject disk image / ZIP" Click="OnEjecImageClick" Name="ItemMenuEjectDisk" IsEnabled="False">
					<MenuItem.Icon>
						<Svg Path="avares://ASE/Assets/Icons/eject.svg" Width="16" Height="16"/>
					</MenuItem.Icon>
				</MenuItem>
				<Separator />
				
				<!-- File options for drive B -->
				<MenuItem Header="DRIVE B:" Theme="{StaticResource MenuSectionHeaderTheme}" />
				<MenuItem Header="Connect drive B:" Name="ItemMenuConnectDriveB" Click="OnConnectDriveBClick">
					<MenuItem.Icon>
						<Svg Path="avares://ASE/Assets/Icons/plug.svg" Width="16" Height="16"/>
					</MenuItem.Icon>
				</MenuItem>
				<!-- Options if drive B is connected -->
				<MenuItem Header="Open disk image…" Name="ItemMenuOpenDiskB" Click="OnOpenImageBClick" IsEnabled="False">
					<MenuItem.Icon>
						<Svg Path="avares://ASE/Assets/Icons/disk.svg" Width="16" Height="16"/>
					</MenuItem.Icon>
				</MenuItem>
				<MenuItem Header="Change disk from ZIP…" Name="ItemMenuChangeDiskB" Click="OnChangeDiskBClick" IsEnabled="False">
					<MenuItem.Icon>
						<Svg Path="avares://ASE/Assets/Icons/zip.svg" Width="16" Height="16"/>
					</MenuItem.Icon>
				</MenuItem>
				<MenuItem Header="Eject disk image / ZIP" Name="ItemMenuEjectDiskB" Click="OnEjecImageBClick" IsEnabled="False">
					<MenuItem.Icon>
						<Svg Path="avares://ASE/Assets/Icons/eject.svg" Width="16" Height="16"/>
					</MenuItem.Icon>
				</MenuItem>

				<Separator/>
				<MenuItem Header="Save snapshot" Click="OnSaveSnapshotClick" InputGesture="F11" >
					<MenuItem.Icon>
						<Svg Path="avares://ASE/Assets/Icons/cone-striped.svg" Width="16" Height="16"/>
					</MenuItem.Icon>
				</MenuItem>
				<MenuItem Header="Restore snapshot…" Click="OnRestoreSnapshotClick">
					<MenuItem.Icon>
						<Svg Path="avares://ASE/Assets/Icons/fast-forward.svg" Width="16" Height="16"/>
					</MenuItem.Icon>
				</MenuItem>
				<Separator/>
				<MenuItem Header="_Library…" Click="OnLibraryClick">
					<MenuItem.Icon>
						<Svg Path="avares://ASE/Assets/Icons/collection-fill.svg" Width="16" Height="16"/>
					</MenuItem.Icon>
				</MenuItem>
				<MenuItem Header="Configure Library…" Click="OnConfigureLibraryClick">
					<MenuItem.Icon>
						<Svg Path="avares://ASE/Assets/Icons/search.svg" Width="16" Height="16"/>
					</MenuItem.Icon>
				</MenuItem>
			</MenuItem>

			<MenuItem Header="Emulation" SubmenuOpened="OnEmulationMenuOpened">
				<MenuItem Header="Configuration…" Click="OnConfigurationClick">
					<MenuItem.Icon>
						<Svg Path="avares://ASE/Assets/Icons/gear.svg" Width="16" Height="16"/>
					</MenuItem.Icon>
				</MenuItem>
				<!-- Greyed out while the toolbox is up (it is a single-instance window) and
				     whenever the ST is not wired to the built-in module, which is all the
				     toolbox is a front panel for. Both are decided when this submenu opens
				     (see MainWindow.OnEmulationMenuOpened / OnMt32ToolboxClick). -->
				<MenuItem Header="MT32 Toolbox" Name="ItemMenuMt32Toolbox" Click="OnMt32ToolboxClick">
					<MenuItem.Icon>
						<Svg Path="avares://ASE/Assets/Icons/tools.svg" Width="16" Height="16"/>
					</MenuItem.Icon>
				</MenuItem>
				<MenuItem Header="Debug…" Click="OnDebugClick">
					<MenuItem.Icon>
						<Svg Path="avares://ASE/Assets/Icons/bug.svg" Width="16" Height="16"/>
					</MenuItem.Icon>
				</MenuItem>
				<Separator/>
				<MenuItem Header="Toggle full screen" Click="OnToggleFullScreenClick" InputGesture="Alt+Enter">
					<MenuItem.Icon>
						<Svg Path="avares://ASE/Assets/Icons/arrows-fullscreen.svg" Width="16" Height="16"/>
					</MenuItem.Icon>
				</MenuItem>
				<Separator/>
				<MenuItem Header="Reset" Click="OnResetClick">
					<MenuItem.Icon>
						<Svg Path="avares://ASE/Assets/Icons/arrow-clockwise.svg" Width="16" Height="16"/>
					</MenuItem.Icon>
				</MenuItem>
				<MenuItem Header="_Quit" Click="OnExitClick">
					<MenuItem.Icon>
						<Svg Path="avares://ASE/Assets/Icons/power.svg" Width="16" Height="16"/>
					</MenuItem.Icon>
				</MenuItem>
			</MenuItem>

			<MenuItem Header="Help">
				<MenuItem Header="About ASE…" Click="OnAboutClick" >
					<MenuItem.Icon>
						<Svg Path="avares://ASE/Assets/Icons/question-circle.svg" Width="16" Height="16"/>
					</MenuItem.Icon>
				</MenuItem>
					<MenuItem Header="Manual…" Click="OnManualClick">
					<MenuItem.Icon>
						<Svg Path="avares://ASE/Assets/Icons/book.svg" Width="16" Height="16"/>
					</MenuItem.Icon>
				</MenuItem>
			</MenuItem>

		</Menu>

		<Border DockPanel.Dock="Bottom" Name="BottomStatusBar"
				Background="#161616"
				Padding="12,5"
				BorderBrush="#2C2C2C"
				BorderThickness="0,1,0,0">
			<DockPanel LastChildFill="False">
				<Border DockPanel.Dock="Right" CornerRadius="4" BorderThickness="1" BorderBrush="#10FFFFFF" Padding="14,2,14,0">
					<Border.Background>
						<LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
							<GradientStop Color="#000000" Offset="0.0"/>
							<GradientStop Color="#202020" Offset="0.2"/>
						</LinearGradientBrush>
					</Border.Background>
					<StackPanel Orientation="Horizontal">
						<!-- Drive A: light first, label to its right, like the HDD pair at the end
						     of the strip. The label lives in a clipping canvas because a canvas
						     measures its children unconstrained, so the text keeps its natural
						     width and a name too long for the strip is scrolled by MainWindow's
						     marquee timer (Canvas.Left) instead of being cut off. -->
						<Image Name="DriveLedImage"
						       Source="./Assets/drive_led_off.png"
						       VerticalAlignment="Center"
						       Height="22" />
						<Canvas Name="DriveLabelClip"
						        Width="130" Height="18"
						        ClipToBounds="True"
						        VerticalAlignment="Center"
						        Margin="5,0,0,0">
							<TextBlock Name="TextBlockDriveStatus"
							           Canvas.Left="0" Canvas.Top="1"
							           FontSize="12"
							           Opacity="0.5"
							           Text="A: Empty"
							           Foreground="{DynamicResource AccentTextBrush}" />
						</Canvas>
						<!-- Drive B, the same pair; the 14 px opens the gap between both drives -->
						<Image Name="DriveBLedImage"
						       Source="./Assets/drive_led_off.png"
						       VerticalAlignment="Center"
						       Height="22"
						       Margin="14,0,0,0"
						       IsVisible="False" />
						<Canvas Name="DriveBLabelClip"
						        Width="130" Height="18"
						        ClipToBounds="True"
						        VerticalAlignment="Center"
						        Margin="5,0,0,0"
						        IsVisible="False">
							<TextBlock Name="TextBlockDriveBStatus"
							           Canvas.Left="0" Canvas.Top="1"
							           FontSize="12"
							           Opacity="0.5"
							           Text="B: Empty"
							           Foreground="{DynamicResource AccentTextBrush}" />
						</Canvas>
						
						<Border
							Width="2"
							Background="#10FFFFFF"
							Margin="10,0"/>
						
						<Image Name="HDLedImage"
						       Source="./Assets/hd_led_off.png"
						       VerticalAlignment="Center"
						       Height="22" />
						<TextBlock Text="HDD"
						           VerticalAlignment="Center"
						           Margin="5,0,0,0"
						           FontSize="12"
						           Opacity="0.5" />
					</StackPanel>
				</Border>
				
				<TextBlock Name="TextBlockStatusBar"
				           VerticalAlignment="Center"
				           FontSize="12"
				           Foreground="#A0A0A0">Press F12/middle mouse button to capture/release input.
					<TextBlock.Styles>
						<Style Selector="TextBlock.fadeOut">
							<Style.Animations>
								<Animation Duration="0:0:1" FillMode="Forward">
									<KeyFrame Cue="0%">
										<Setter Property="Opacity" Value="1.0"/>
									</KeyFrame>
									<KeyFrame Cue="100%">
										<Setter Property="Opacity" Value="0.0"/>
									</KeyFrame>
								</Animation>
							</Style.Animations>
						</Style>
					</TextBlock.Styles>
				</TextBlock>
			</DockPanel>
		</Border>

		<Grid>
			<local:GLControl Name="GlDisplay" />
			<Border x:Name="GlInputOverlay"
					Background="Transparent"
					ZIndex="10"/>
		</Grid>

	</DockPanel>
</Window>
