<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" Width="500" Height="220"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        x:Class="ASE.ScraperWindow"
        Title="Scraper">
    
        <StackPanel Orientation="Vertical" Margin="20" Spacing="10">

                <Border Classes="card">
                        <StackPanel Spacing="10">
                                <TextBlock Classes="section" Text="Library scan…"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <ProgressBar x:Name="ProgressScraper"  Margin="0 10" Height="30"
                                                      Minimum="0" Maximum="100" Value="0"
                                                      ShowProgressText="True"/>
                                        <Button x:Name="ButtonCancelScraper" Grid.Column="1" IsEnabled="True" Content="Cancel"/>
                                </Grid>
                                <TextBlock x:Name="TextFilename" FontSize="11" Opacity="0.6"></TextBlock>
                        </StackPanel>
                </Border>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0" Spacing="8">
                        <Button x:Name="ButtonOk" Content="Ok" IsEnabled="False" Classes="accent" Width="90" HorizontalContentAlignment="Center" />
                </StackPanel>
                
        </StackPanel>
        
</Window>
