<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" Width="500" SizeToContent="Height" 
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        x:Class="ASE.LibraryConfigurationWindow"
        Title="Library configuration">

        <StackPanel Orientation="Vertical" Margin="20" Spacing="10">

                <Border Classes="card">
                        <StackPanel Spacing="10">
                                <TextBlock Classes="section" Text="Library path"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBox Grid.Column="0" x:Name="TextLibraryPath" IsReadOnly="True" />
                                        <Button Grid.Column="1" Content="Browse…" Click="OnLibraryPathClick" />
                                </Grid>
                        </StackPanel>
                </Border>
                <Border Classes="card">
                        <StackPanel Spacing="10">
                                <TextBlock Classes="section" Text="Screenscraper"/>
                                <Grid ColumnDefinitions="Auto,200" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="10" HorizontalAlignment="Center">
                                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="User" />
                                        <TextBox Grid.Column="1" Grid.Row="0" x:Name="TextSSUser" PlaceholderText="User ID" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Password" />
                                        <TextBox Grid.Column="1" Grid.Row="1" x:Name="TextSSPass" PlaceholderText="Password" PasswordChar="*" />
                                        <TextBlock Grid.Column="0" Grid.Row="2" VerticalAlignment="Center">Download media</TextBlock>
                                        <ToggleSwitch Grid.Column="1" Grid.Row="2" x:Name="SwitchDownloadMedia"></ToggleSwitch>
                                </Grid>
                                <Button HorizontalAlignment="Right" Content="Download Metadata &amp; Artwork" Click="OnScanLibraryClick" />
                        </StackPanel>
                </Border>
                <Border Classes="card" x:Name="CardVlcPath">
                        <StackPanel Spacing="10">
                                <TextBlock Classes="section" Text="Game preview videos (VLC)"/>
                                <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="12" Text="If you have VLC installed somewhere other than the default location, point this at its installation folder." />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBox Grid.Column="0" x:Name="TextVlcPath" IsReadOnly="True" PlaceholderText="Default: Program Files\VideoLAN\VLC" />
                                        <Button Grid.Column="1" Content="Browse…" Click="OnVlcPathClick" />
                                </Grid>
                        </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0" Spacing="8">
                        <Button Content="OK" Classes="accent" Width="90" HorizontalContentAlignment="Center" Click="OnOkClick" />
                        <Button Content="Cancel" HorizontalContentAlignment="Center" Click="OnCancelClick" Width="90" />
                </StackPanel>
                
        </StackPanel>
</Window>
