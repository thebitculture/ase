<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ASE"
        xmlns:svg="clr-namespace:Avalonia.Svg;assembly=Svg.Controls.Avalonia"
        mc:Ignorable="d"
        x:Class="ASE.DebugWindow"
        x:DataType="local:DebugWindow"
        Title="Debug"
        Classes="aseDialog"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        Width="1120"
        Height="810">

    <Window.Resources>
        <local:NumericControlHexConverter x:Key="HexConverter"/>
    </Window.Resources>

    <Window.Styles>
        <!-- Debugger-specific styles. Shared dialog styling lives in AseDialogs.axaml. -->

        <!--
          Listing line states. Two independent channels so none of them hides another:
          the fill and the left bar say what the line is, and the gutter repeats it with
          a shape (red dot = breakpoint, arrow = PC) that survives every combination —
          a line that is both stays orange, but its red dot still shows the run stopped
          there because of the breakpoint. Declaration order picks the fill when several
          styles apply: breakpoint < selection < PC.
        -->
        <Style Selector="Border.bp">
            <Setter Property="Background" Value="#482225" />
            <Setter Property="BorderBrush" Value="#C44A4A" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
        </Style>

        <!--
          Selection is deliberately blue, far from the orange/red of the debugger states:
          drawn in the accent it read as "clicking a line moves the PC there".
        -->
        <Style Selector="Border.sel">
            <Setter Property="Background" Value="#1B3552" />
            <Setter Property="BorderBrush" Value="#4A90D9" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
        </Style>

        <Style Selector="Border.marked">
            <Setter Property="Background" Value="{DynamicResource AccentSoftHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
        </Style>

        <!-- Gutter marks. The breakpoint one is drawn, not a glyph, so no font can lose it. -->
        <Style Selector="Border.bpDot">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Background" Value="#C44A4A" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <!--
          U+2192 RIGHTWARDS ARROW is in the WGL4 set, so every UI font ASE can end up with
          has it: Segoe UI on Windows, the system font on macOS, DejaVu/Noto/Liberation on
          Linux. The listing's Courier New also carries it, but draws it thin and tiny, so
          the mark uses the UI font at a size well above the code's. The negative vertical
          margin keeps that taller glyph out of the row's height calculation: the PC line
          measures the same as every other one and stepping never shifts the listing.
        -->
        <Style Selector="TextBlock.pcArrow">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentSelectedBrush}" />
            <Setter Property="Margin" Value="0,-5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style Selector="Border.codeSurface">
            <Setter Property="Background" Value="{DynamicResource DialogBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="5" />
        </Style>

        <Style Selector="TextBox.registerValue">
            <Setter Property="FontFamily" Value="Courier New" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <Style Selector="CheckBox.srFlag">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="2,0,5,0" />
        </Style>

        <Style Selector="ToggleButton.debugAction">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style Selector="ToggleButton.breakpointToggle:checked">
            <Setter Property="Background" Value="#8B2E2E" />
            <Setter Property="BorderBrush" Value="#C44A4A" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="Border.legendDot">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Debugger pages -->
        <TabControl Grid.Row="1"
                    Margin="24,20,24,0">

            <!-- CPU -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <Svg Path="avares://ASE/Assets/Icons/cpu.svg"
                                 Width="17"
                                 Height="17"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="CPU"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="0,14,0,8"
                      RowDefinitions="*,Auto"
                      ColumnDefinitions="*,390"
                      RowSpacing="12"
                      ColumnSpacing="12">

                    <!-- Disassembly -->
                    <Border Grid.Row="0"
                            Grid.Column="0"
                            Classes="card">
                        <Grid RowDefinitions="Auto,*">

                            <Grid Grid.Row="0"
                                  ColumnDefinitions="*,Auto"
                                  ColumnSpacing="16">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="section"
                                               Text="Disassembly" />
                                    <TextBlock Classes="description"
                                               Text="Select an instruction to manage breakpoints or navigate execution." />
                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="12"
                                            VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <TextBlock Classes="pcArrow"
                                                   Text="&#x2192;" />
                                        <TextBlock Classes="description"
                                                   VerticalAlignment="Center"
                                                   Text="Current PC" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <Border Classes="legendDot"
                                                Background="#C44A4A" />
                                        <TextBlock Classes="description"
                                                   VerticalAlignment="Center"
                                                   Text="Breakpoint" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <Border Classes="legendDot"
                                                Background="#4A90D9" />
                                        <TextBlock Classes="description"
                                                   VerticalAlignment="Center"
                                                   Text="Selected line" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="1"
                                    Classes="codeSurface"
                                    Margin="0,12,0,0">
                                <ListBox x:Name="lstListing"
                                         ItemsSource="{Binding DasmListing}"
                                         SelectionChanged="OnListingSelectionChanged"
                                         ContextRequested="OnListingContextRequested"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Hidden">
                                    <!--
                                      Right-click menu (or Ctrl+click on macOS). Every entry acts on
                                      the selected line, which OnListingContextRequested moves to the
                                      one under the pointer before the menu shows.
                                    -->
                                    <ListBox.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Toggle breakpoint"
                                                      Click="OnContextToggleBreakpointClick">
                                                <MenuItem.Icon>
                                                    <Svg Path="avares://ASE/Assets/Icons/bug.svg" Width="16" Height="16"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Run to this line"
                                                      Click="OnRunToLineClick">
                                                <MenuItem.Icon>
                                                    <Svg Path="avares://ASE/Assets/Icons/play-fill.svg" Width="16" Height="16"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator/>
                                            <MenuItem Header="Set PC to this line"
                                                      Click="OnSetPcToLineClick">
                                                <MenuItem.Icon>
                                                    <Svg Path="avares://ASE/Assets/Icons/cpu.svg" Width="16" Height="16"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </ListBox.ContextMenu>
                                    <ListBox.Styles>
                                        <Style Selector="ListBoxItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0" />
                                            <Setter Property="MinHeight" Value="0" />
                                        </Style>
                                        <!--
                                          The line Border draws the selection itself (blue): the
                                          theme's own selected chrome is accent-coloured, the very
                                          thing that made a click look like a PC move. Hover chrome
                                          is left alone, it is a neutral overlay.
                                        -->
                                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                                            <Setter Property="Background" Value="Transparent" />
                                        </Style>
                                        <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                            <Setter Property="Background" Value="Transparent" />
                                        </Style>
                                        <Style Selector="ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
                                            <Setter Property="Background" Value="Transparent" />
                                        </Style>
                                    </ListBox.Styles>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="local:DebugWindow+DasmLine">
                                            <Border Classes.bp="{Binding IsBreakpoint}"
                                                    Classes.sel="{Binding $parent[ListBoxItem].IsSelected}"
                                                    Classes.marked="{Binding IsPC}"
                                                    Padding="5,2">
                                                <Grid ColumnDefinitions="12,16,*">
                                                    <Border Classes="bpDot"
                                                            IsVisible="{Binding IsBreakpoint}" />
                                                    <TextBlock Grid.Column="1"
                                                               Classes="pcArrow"
                                                               IsVisible="{Binding IsPC}"
                                                               Text="&#x2192;" />
                                                    <TextBlock Grid.Column="2"
                                                               FontFamily="Courier New"
                                                               FontSize="12"
                                                               Text="{Binding DasmCodeLine}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Registers -->
                    <Border Grid.Row="0"
                            Grid.Column="1"
                            Classes="card">
                        <StackPanel Spacing="12">

                            <StackPanel Spacing="2">
                                <TextBlock Classes="section"
                                           Text="Registers" />
                                <TextBlock Classes="description"
                                           Text="Edit values directly; Enter commits the current field." />
                            </StackPanel>

                            <!-- PC and stack pointer -->
                            <Grid ColumnDefinitions="*,14,*"
                                  ColumnSpacing="0">
                                <Grid Grid.Column="0"
                                      ColumnDefinitions="Auto,*"
                                      ColumnSpacing="8">
                                    <TextBlock Classes="fieldLabel"
                                               VerticalAlignment="Center"
                                               Text="PC" />
                                    <TextBox Grid.Column="1"
                                             x:Name="txtPC"
                                             Classes="registerValue"
                                             Tag="PC"
                                             LostFocus="OnRegisterLostFocus"
                                             KeyDown="OnRegisterKeyDown">$000000</TextBox>
                                </Grid>

                                <Grid Grid.Column="2"
                                      ColumnDefinitions="Auto,*"
                                      ColumnSpacing="8">
                                    <TextBlock Classes="fieldLabel"
                                               VerticalAlignment="Center"
                                               Text="SP" />
                                    <TextBox Grid.Column="1"
                                             x:Name="txtSP"
                                             Classes="registerValue"
                                             Tag="SP"
                                             LostFocus="OnRegisterLostFocus"
                                             KeyDown="OnRegisterKeyDown">$000000</TextBox>
                                </Grid>
                            </Grid>

                            <Border Height="1"
                                    Background="{DynamicResource CardBorderBrush}" />

                            <!-- Address and data registers -->
                            <Grid ColumnDefinitions="*,18,*">

                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Classes="fieldLabel"
                                               Text="ADDRESS REGISTERS" />

                                    <Grid ColumnDefinitions="Auto,*"
                                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                          ColumnSpacing="8"
                                          RowSpacing="6">
                                        <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="A0" />
                                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtA0" Classes="registerValue" Tag="A0" LostFocus="OnRegisterLostFocus" KeyDown="OnRegisterKeyDown">$000000</TextBox>
                                        <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="A1" />
                                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtA1" Classes="registerValue" Tag="A1" LostFocus="OnRegisterLostFocus" KeyDown="OnRegisterKeyDown">$000000</TextBox>
                                        <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="A2" />
                                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtA2" Classes="registerValue" Tag="A2" LostFocus="OnRegisterLostFocus" KeyDown="OnRegisterKeyDown">$000000</TextBox>
                                        <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="A3" />
                                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtA3" Classes="registerValue" Tag="A3" LostFocus="OnRegisterLostFocus" KeyDown="OnRegisterKeyDown">$000000</TextBox>
                                        <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="A4" />
                                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="txtA4" Classes="registerValue" Tag="A4" LostFocus="OnRegisterLostFocus" KeyDown="OnRegisterKeyDown">$000000</TextBox>
                                        <TextBlock Grid.Row="5" VerticalAlignment="Center" Text="A5" />
                                        <TextBox Grid.Row="5" Grid.Column="1" x:Name="txtA5" Classes="registerValue" Tag="A5" LostFocus="OnRegisterLostFocus" KeyDown="OnRegisterKeyDown">$000000</TextBox>
                                        <TextBlock Grid.Row="6" VerticalAlignment="Center" Text="A6" />
                                        <TextBox Grid.Row="6" Grid.Column="1" x:Name="txtA6" Classes="registerValue" Tag="A6" LostFocus="OnRegisterLostFocus" KeyDown="OnRegisterKeyDown">$000000</TextBox>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Spacing="6">
                                    <TextBlock Classes="fieldLabel"
                                               Text="DATA REGISTERS" />

                                    <Grid ColumnDefinitions="Auto,*"
                                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                          ColumnSpacing="8"
                                          RowSpacing="6">
                                        <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="D0" />
                                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtD0" Classes="registerValue" Tag="D0" LostFocus="OnRegisterLostFocus" KeyDown="OnRegisterKeyDown">$000000</TextBox>
                                        <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="D1" />
                                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtD1" Classes="registerValue" Tag="D1" LostFocus="OnRegisterLostFocus" KeyDown="OnRegisterKeyDown">$000000</TextBox>
                                        <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="D2" />
                                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtD2" Classes="registerValue" Tag="D2" LostFocus="OnRegisterLostFocus" KeyDown="OnRegisterKeyDown">$000000</TextBox>
                                        <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="D3" />
                                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtD3" Classes="registerValue" Tag="D3" LostFocus="OnRegisterLostFocus" KeyDown="OnRegisterKeyDown">$000000</TextBox>
                                        <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="D4" />
                                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="txtD4" Classes="registerValue" Tag="D4" LostFocus="OnRegisterLostFocus" KeyDown="OnRegisterKeyDown">$000000</TextBox>
                                        <TextBlock Grid.Row="5" VerticalAlignment="Center" Text="D5" />
                                        <TextBox Grid.Row="5" Grid.Column="1" x:Name="txtD5" Classes="registerValue" Tag="D5" LostFocus="OnRegisterLostFocus" KeyDown="OnRegisterKeyDown">$000000</TextBox>
                                        <TextBlock Grid.Row="6" VerticalAlignment="Center" Text="D6" />
                                        <TextBox Grid.Row="6" Grid.Column="1" x:Name="txtD6" Classes="registerValue" Tag="D6" LostFocus="OnRegisterLostFocus" KeyDown="OnRegisterKeyDown">$000000</TextBox>
                                        <TextBlock Grid.Row="7" VerticalAlignment="Center" Text="D7" />
                                        <TextBox Grid.Row="7" Grid.Column="1" x:Name="txtD7" Classes="registerValue" Tag="D7" LostFocus="OnRegisterLostFocus" KeyDown="OnRegisterKeyDown">$000000</TextBox>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- Status register -->
                            <Border CornerRadius="8"
                                    Background="{DynamicResource AccentSoftBrush}"
                                    Padding="10,8">
                                <StackPanel Spacing="7">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Classes="fieldLabel"
                                                   VerticalAlignment="Center"
                                                   Text="STATUS REGISTER" />
                                        <TextBlock Grid.Column="1"
                                                   x:Name="txtSRValue"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Courier New"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentTextBrush}">$0000</TextBlock>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal"
                                                Spacing="5">
                                        <CheckBox x:Name="chkT" Classes="srFlag" Click="OnSRFlagClick">T</CheckBox>
                                        <CheckBox x:Name="chkS" Classes="srFlag" Click="OnSRFlagClick">S</CheckBox>
                                        <CheckBox x:Name="chkI2" Classes="srFlag" Click="OnSRFlagClick">I2</CheckBox>
                                        <CheckBox x:Name="chkI1" Classes="srFlag" Click="OnSRFlagClick">I1</CheckBox>
                                        <CheckBox x:Name="chkI0" Classes="srFlag" Click="OnSRFlagClick">I0</CheckBox>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal"
                                                Spacing="5">
                                        <CheckBox x:Name="chkX" Classes="srFlag" Click="OnSRFlagClick">X</CheckBox>
                                        <CheckBox x:Name="chkN" Classes="srFlag" Click="OnSRFlagClick">N</CheckBox>
                                        <CheckBox x:Name="chkZ" Classes="srFlag" Click="OnSRFlagClick">Z</CheckBox>
                                        <CheckBox x:Name="chkV" Classes="srFlag" Click="OnSRFlagClick">V</CheckBox>
                                        <CheckBox x:Name="chkC" Classes="srFlag" Click="OnSRFlagClick">C</CheckBox>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- CPU command bar -->
                    <Border Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Classes="card"
                            Padding="10">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="8">

                            <Button x:Name="btnStep"
                                    Classes="compact"
                                    Click="OnStepClick">Step (F10)</Button>

                            <ToggleButton x:Name="tglBreakpoint"
                                          Classes="debugAction breakpointToggle"
                                          Content="Breakpoint"
                                          Click="OnBreakpointToggle"
                                          ToolTip.Tip="Set or clear a breakpoint on the selected instruction" />

                            <Button x:Name="btnRunToBp"
                                    Classes="compact"
                                    Click="OnRunToBreakpointClick"
                                    IsEnabled="False">Run until breakpoint</Button>

                            <Button x:Name="btnClearBreakpoint"
                                    Classes="compact"
                                    Click="OnClearBreakpointClick">Clear breakpoints</Button>

                            <Border Width="1"
                                    Margin="6,2"
                                    Background="{DynamicResource CardBorderBrush}"
                                    VerticalAlignment="Stretch" />

                            <Button x:Name="btnSaveListing"
                                    Classes="compact"
                                    Click="OnSaveListingClick">Save listing...</Button>

                            <Border Width="1"
                                    Margin="6,2"
                                    Background="{DynamicResource CardBorderBrush}"
                                    VerticalAlignment="Stretch" />

                            <Button x:Name="btnGotoPC"
                                    Classes="compact"
                                    Click="OnGotoPCClick">Back to PC</Button>

                            <TextBox x:Name="txtGotoAddr"
                                     Width="120"
                                     PlaceholderText="Hex. address"
                                     KeyDown="OnGotoAddrKeyDown" />

                            <Button x:Name="btnGoto"
                                    Classes="compact"
                                    Click="OnGotoAddrClick">Go</Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Memory -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <Svg Path="avares://ASE/Assets/Icons/memory.svg"
                                 Width="17"
                                 Height="17"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="Memory"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="0,14,0,8"
                      RowDefinitions="*,Auto"
                      RowSpacing="12">

                    <Border Grid.Row="0"
                            Classes="card">
                        <Grid RowDefinitions="Auto,*">
                            <StackPanel Grid.Row="0" Spacing="2">
                                <TextBlock Classes="section"
                                           Text="Memory viewer" />
                                <TextBlock Classes="description"
                                           Text="Inspect and edit RAM directly. ROM and I/O regions remain read-only." />
                            </StackPanel>

                            <Border Grid.Row="1"
                                    Classes="codeSurface"
                                    Margin="0,12,0,0">
                                <local:HexEditor x:Name="hexView"
                                                 ToolTip.Tip="Click a byte and type to edit RAM: hex digits in the hex column, characters in the ASCII column (Tab switches columns; ROM and I/O are read-only)"
                                                 Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                                 AddressBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                 AsciiBrush="{DynamicResource SystemControlForegroundBaseMediumHighBrush}" />
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Classes="card"
                            Padding="10">
                        <Grid ColumnDefinitions="Auto,120,Auto,1,Auto,*,Auto"
                              ColumnSpacing="8">

                            <TextBlock Grid.Column="0"
                                       Classes="fieldLabel"
                                       VerticalAlignment="Center"
                                       Text="ADDRESS" />

                            <TextBox Grid.Column="1"
                                     x:Name="txtMemAddr"
                                     PlaceholderText="Hex. address"
                                     KeyDown="OnMemGotoKeyDown" />

                            <Button Grid.Column="2"
                                    x:Name="btnMemGoto"
                                    Classes="compact"
                                    Click="OnMemGotoClick">Go</Button>

                            <Border Grid.Column="3"
                                    Width="1"
                                    Margin="6,2"
                                    Background="{DynamicResource CardBorderBrush}"
                                    VerticalAlignment="Stretch" />

                            <Button Grid.Column="4"
                                    x:Name="btnSnapshot"
                                    Classes="compact"
                                    Click="OnSnapshotClick">Save snapshot...</Button>

                            <Border Grid.Column="6"
                                    Classes="statusPill"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right">
                                <TextBlock x:Name="txtMemStatus"
                                           Classes="statusPill"
                                           FontFamily="Courier New">Data</TextBlock>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Bitmap explorer -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <Svg Path="avares://ASE/Assets/Icons/image.svg"
                                 Width="17"
                                 Height="17"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="Bitmap explorer"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="0,14,0,8"
                      RowDefinitions="*,Auto"
                      ColumnDefinitions="*,390"
                      RowSpacing="12"
                      ColumnSpacing="12">

                    <!--
                      Display. The bitmap is built at the ST's own resolution and blown up by an
                      integer factor with Stretch="Fill" plus nearest-neighbour sampling, so one
                      ST pixel is exactly Zoom device pixels and nothing is ever filtered. Only
                      the horizontal axis scrolls: the row count is computed to fill the viewport,
                      so there is never anything below the fold.
                    -->
                    <Border Grid.Row="0" Grid.Column="0"
                            Classes="codeSurface"
                            Padding="1"
                            ClipToBounds="True">
                        <ScrollViewer x:Name="bmpScroll"
                                      Background="Black"
                                      ToolTip.Tip="Wheel: scrolls one line. Shift+wheel: eight lines. Ctrl+wheel: a single byte, to roll a sprite that does not start on a line boundary into phase."
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled"
                                      SizeChanged="OnBitmapViewportSizeChanged">
                            <Image Name="PixelImage"
                                   Stretch="Fill"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"
                                   RenderOptions.BitmapInterpolationMode="None" />
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Row="0"
                            Grid.Column="1"
                            Classes="card">

                        <StackPanel Spacing="12">

                            <StackPanel Spacing="2">
                                <TextBlock Classes="section"
                                           Text="Bitmap explorer" />
                                <TextBlock Classes="description"
                                           TextWrapping="Wrap"
                                           Text="Reads RAM as Atari bitplanes and paints it with the palette the machine is holding right now. Use it to find sprites, tiles and screen buffers." />
                            </StackPanel>

                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="8">
                                <TextBlock Classes="fieldLabel"
                                           VerticalAlignment="Center"
                                           Text="Start address" />
                                <!--
                                  Increment is set from the code-behind to one bitmap line
                                  (bytes width x bitplanes), so the spinner scrolls the dump line
                                  by line and a sprite sheet stays in phase.
                                -->
                                <!--
                                  Value is deliberately NOT set here: it starts null and the
                                  code-behind writes the first address, which is what makes
                                  NumericUpDown run the converter and actually paint the box.
                                  A value declared in XAML never changes, so the control would
                                  come up blank.
                                -->
                                <NumericUpDown Grid.Column="1"
                                               x:Name="numBmpAddr"
                                               Minimum="0"
                                               Maximum="4194303"
                                               Increment="160"
                                               ClipValueToMinMax="True"
                                               TextConverter="{StaticResource HexConverter}"
                                               ValueChanged="OnBitmapParamChanged"
                                               ToolTip.Tip="Hexadecimal address of the first byte of the dump ($ and 0x are accepted). The arrows move one bitmap line." />
                            </Grid>

                            <Border Height="1" Background="{DynamicResource CardBorderBrush}" />

                            <Grid ColumnDefinitions="*,14,*" ColumnSpacing="0">
                                <Grid Grid.Column="0"
                                      ColumnDefinitions="Auto,*"
                                      ColumnSpacing="8">
                                    <TextBlock Classes="fieldLabel"
                                               VerticalAlignment="Center"
                                               Text="Bytes width" />
                                    <NumericUpDown Grid.Column="1"
                                                   x:Name="numBmpBytes"
                                                   Classes="SmallSpinner"
                                                   Value="40"
                                                   Minimum="2"
                                                   Maximum="80"
                                                   Increment="2"
                                                   FormatString="0"
                                                   ValueChanged="OnBitmapParamChanged"
                                                   ToolTip.Tip="Bytes per bitplane on each line: 8 pixels per byte (a 16-pixel wide sprite is 2)" />
                                </Grid>

                                <Grid Grid.Column="2"
                                      ColumnDefinitions="Auto,*"
                                      ColumnSpacing="8">
                                    <TextBlock Classes="fieldLabel"
                                               VerticalAlignment="Center"
                                               Text="Bitplanes" />
                                    <NumericUpDown Grid.Column="1"
                                                   x:Name="numBmpPlanes"
                                                   Classes="SmallSpinner"
                                                   Value="4"
                                                   Minimum="1"
                                                   Maximum="4"
                                                   Increment="1"
                                                   FormatString="0"
                                                   ValueChanged="OnBitmapParamChanged"
                                                   ToolTip.Tip="Planes interleaved per line: 1 = 2 colours, 2 = 4, 3 = 8, 4 = 16" />
                                </Grid>
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <TextBlock Classes="fieldLabel"
                                           VerticalAlignment="Center"
                                           Text="Zoom" />
                                <NumericUpDown Grid.Column="1"
                                               x:Name="numBmpZoom"
                                               Classes="SmallSpinner"
                                               Value="4"
                                               Minimum="1"
                                               Maximum="12"
                                               Increment="1"
                                               FormatString="0"
                                               ValueChanged="OnBitmapParamChanged"
                                               ToolTip.Tip="Device pixels per ST pixel. An ST pixel drawn 1:1 is unreadably small on a modern screen, hence the default of 4." />
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <TextBlock Classes="fieldLabel"
                                           VerticalAlignment="Center"
                                           Text="Wrap" />
                                <ToggleSwitch Grid.Column="1"
                                              x:Name="tglBmpWrap"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              MinWidth="0"
                                              OffContent="Single strip"
                                              OnContent="Columns"
                                              IsCheckedChanged="OnBitmapWrapChanged"
                                              ToolTip.Tip="Off: one strip the width of the line, scrolled. On: the dump carries on at the top of the next column when it reaches the bottom, filling the pane - which is what turns a run of sprites into a sheet." />
                            </Grid>

                            <Border Height="1" Background="{DynamicResource CardBorderBrush}" />

                            <StackPanel Spacing="6">
                                <TextBlock Classes="fieldLabel"
                                           Text="ACTIVE PALETTE" />
                                <!--
                                  The 16 colour registers as they stand at $FF8240. Entries the
                                  current bitplane count cannot reach are dimmed, so it is obvious
                                  which part of the strip the dump is actually using.
                                -->
                                <UniformGrid x:Name="palStrip"
                                             Rows="2"
                                             Columns="8" />
                            </StackPanel>

                            <Border Height="1" Background="{DynamicResource CardBorderBrush}" />

                            <TextBlock x:Name="txtBmpInfo"
                                       Classes="description"
                                       TextWrapping="Wrap"
                                       FontFamily="Courier New"
                                       Text="-" />
                        </StackPanel>

                    </Border>

                    <!-- Bitmap command bar -->
                    <Border Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Classes="card"
                            Padding="10">
                        <Grid ColumnDefinitions="Auto,Auto,1,Auto,*,Auto"
                              ColumnSpacing="8">

                            <Button Grid.Column="0"
                                    x:Name="btnBmpScreenBase"
                                    Classes="compact"
                                    Click="OnBitmapScreenBaseClick"
                                    ToolTip.Tip="Jump to the address the shifter is displaying from ($FF8201/03/0D)">Screen base</Button>

                            <Button Grid.Column="1"
                                    x:Name="btnBmpMemCursor"
                                    Classes="compact"
                                    Click="OnBitmapMemoryCursorClick"
                                    ToolTip.Tip="Jump to the byte the Memory tab is parked on">From memory cursor</Button>

                            <Border Grid.Column="2"
                                    Width="1"
                                    Margin="6,2"
                                    Background="{DynamicResource CardBorderBrush}"
                                    VerticalAlignment="Stretch" />

                            <Button Grid.Column="3"
                                    x:Name="btnBmpExport"
                                    Classes="compact"
                                    Click="OnBitmapExportClick"
                                    ToolTip.Tip="Writes the dump as a PNG at 1:1 (one file pixel per ST pixel), ready to cut sprites out of">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Svg Path="avares://ASE/Assets/Icons/camera.svg"
                                         Width="15"
                                         Height="15"
                                         VerticalAlignment="Center" />
                                    <TextBlock Text="Export PNG..." VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Border Grid.Column="5"
                                    Classes="statusPill"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right">
                                <TextBlock x:Name="txtBmpStatus"
                                           Classes="statusPill"
                                           FontFamily="Courier New">Bitmap</TextBlock>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

            </TabItem>
        </TabControl>

        <!-- Resume execution -->
        <Border Grid.Row="2"
                Classes="dialogFooter"
                Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Continue"
                        Classes="accent dialogAction"
                        Click="OnContinueClick" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
