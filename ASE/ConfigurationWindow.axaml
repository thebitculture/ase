<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svg="clr-namespace:Avalonia.Svg;assembly=Svg.Controls.Avalonia"
        xmlns:local="clr-namespace:ASE"
        Classes="aseDialog"
        x:Class="ASE.ConfigurationWindow"
        x:DataType="local:Config+ConfigOptions"
        Title="Configuration"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        Width="960" Height="740">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="24,20,24,16" ColumnSpacing="14">
            <Border Classes="dialogHeaderIcon">
                <Svg Path="avares://ASE/Assets/Icons/gear.svg"
                     Width="22" Height="22"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <TextBlock Classes="windowTitle" Text="Configuration" />
                <TextBlock Classes="description"
                           x:Name="TextHeaderDescription"
                           TextWrapping="Wrap"
                           Text="Configure the machine, display, input, storage and MIDI" />
            </StackPanel>
        </Grid>

        <!-- Main content -->
        <TabControl Grid.Row="1"
                    x:Name="Tabs"
                    Classes="settingsNavigation"
                    TabStripPlacement="Left"
                    Margin="24,0,24,0">
            
            <!-- SETUP -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Svg Path="avares://ASE/Assets/Icons/gear.svg" Width="18" Height="18" Margin="0,2,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="Machine" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>

                    <StackPanel Classes="settingsContent" Spacing="12">
                        <Border Classes="card">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="section" Text="Machine" />
                                    <TextBlock Classes="description" Text="Choose the emulated Atari model and installed memory." />
                                </StackPanel>

                                <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="12" ColumnSpacing="18">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="fieldLabel" VerticalAlignment="Center" Text="ATARI MODEL" />
                                    <ComboBox x:Name="ComboModel"
                                              Grid.Row="0" Grid.Column="1"
                                              MaxDropDownHeight="140"
                                              HorizontalAlignment="Stretch"
                                              SelectedIndex="{Binding STModel, Mode=TwoWay}"
                                              SelectionChanged="Model_SelectionChanged">
                                        <ComboBoxItem>Atari STF/FM</ComboBoxItem>
                                        <ComboBoxItem>Atari Mega ST</ComboBoxItem>
                                        <ComboBoxItem>Atari STE</ComboBoxItem>
                                    </ComboBox>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="fieldLabel" VerticalAlignment="Center" Text="MEMORY" />
                                    <ComboBox Grid.Row="1" Grid.Column="1"
                                              MaxDropDownHeight="180"
                                              HorizontalAlignment="Stretch"
                                              SelectedIndex="{Binding RAMConfiguration, Mode=TwoWay}"
                                              SelectionChanged="Memory_SelectionChanged">
                                        <ComboBoxItem>512KB</ComboBoxItem>
                                        <ComboBoxItem>1MB</ComboBoxItem>
                                        <ComboBoxItem>2MB</ComboBoxItem>
                                        <ComboBoxItem>4MB</ComboBoxItem>
                                    </ComboBox>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Classes="fieldLabel" VerticalAlignment="Center" Text="CLOCK" />
                                    <CheckBox x:Name="ChkRealTimeClock"
                                              Grid.Row="2" Grid.Column="1"
                                              VerticalAlignment="Center"
                                              Content="Real-time clock"
                                              IsCheckedChanged="ChkRealTimeClock_OnIsCheckedChanged"
                                              ToolTip.Tip="The Mega ST's battery clock. TOS 1.02 to 1.62 only take the date from it at boot, so without it they start on the date the ROM was built; EmuTOS and TOS 2.05/2.06 also read the keyboard's clock. The Mega ST model always has it. EmuTOS calls an STF/FM with this clock a Mega ST." />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="card">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="section" Text="TOS ROM" />
                                    <TextBlock Classes="description" Text="Select the ROM image used to boot the emulated machine." />
                                </StackPanel>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <TextBox Grid.Column="0"
                                             x:Name="TextTOSImage"
                                             IsReadOnly="True"
                                             Text="{Binding TOSPath}" />
                                    <Button Grid.Column="1"
                                            Classes="compact"
                                            Content="Browse…"
                                            Click="OnBrowseTOSImageClick" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
            </TabItem>

            <!-- VIDEO -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Svg Path="avares://ASE/Assets/Icons/tv.svg" Width="18" Height="18" Margin="0,2,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="Video" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>

                <StackPanel Classes="settingsContent" Spacing="0">

                    <!-- Monitor mode is always visible. In monochrome high resolution the colour
                         CRT shader and border controls below are bypassed. -->
                    <Border Classes="card">
                        <StackPanel Spacing="11">

                            <!-- Two selectable cards rather than a switch: both monitors are
                                 valid hardware, so neither may look like the "off" position. -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">

                                <RadioButton Grid.Column="0"
                                             Classes="optionCard"
                                             Name="RadioColourMonitor"
                                             GroupName="MonitorType"
                                             Width="204">
                                    <StackPanel Spacing="7">
                                        <Svg Path="avares://ASE/Assets/Icons/SC1224.svg"
                                             Width="64" Height="52"
                                             HorizontalAlignment="Center" />

                                        <TextBlock Classes="optionTitle" Text="Colour · SC1224 / TV" />
                                        <TextBlock Classes="optionSpecs" Text="320×200 · 50Hz · CRT effects" />
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton Grid.Column="1"
                                             Classes="optionCard"
                                             Name="RadioMonochromeMonitor"
                                             GroupName="MonitorType"
                                             Width="204"
                                             IsCheckedChanged="RadioMonochromeMonitor_OnIsCheckedChanged">
                                    <StackPanel Spacing="7">
                                        <Svg Path="avares://ASE/Assets/Icons/SM124.svg"
                                             Width="64" Height="52"
                                             HorizontalAlignment="Center" />

                                        <TextBlock Classes="optionTitle" Text="Monochrome · SM124" />
                                        <TextBlock Classes="optionSpecs" Text="640×400 · 71Hz · no effects" />
                                    </StackPanel>
                                </RadioButton>
                            </Grid>

                        </StackPanel>
                    </Border>

                    <!-- The physical height still collapses so the space is reclaimed, but the
                         content fades and moves slightly first; code-behind wires the transitions. -->
                    <Border x:Name="CrtEffectsClip"
                            ClipToBounds="True"
                            VerticalAlignment="Top">
                        <Border Classes="card" Margin="0,12,0,0">
                            <StackPanel Spacing="11">

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Classes="section" Text="CRT effects" />
                                        <TextBlock Classes="description"
                                                   Text="Fine-tune the colour display shader. Values are preserved when effects are switched off." />
                                    </StackPanel>

                                    <!-- Checked means effects are enabled. The stored configuration
                                         flag is DisableCrtEffects, so code-behind keeps them inverted. -->
                                    <ToggleSwitch Grid.Column="1"
                                                  Name="ToggleEffects"
                                                  VerticalAlignment="Center"
                                                  MinWidth="0"
                                                  OffContent="Effects off"
                                                  OnContent="Effects on"
                                                  IsCheckedChanged="ToggleEffects_OnIsCheckedChanged" />
                                </Grid>

                                <!-- Three compact columns keep every CRT control visible without scrolling. -->
                                <Grid Name="GridEffectSliders"
                                      ColumnDefinitions="*,18,*,18,*"
                                      RowDefinitions="Auto,Auto,Auto"
                                      RowSpacing="7">

                                    <StackPanel Grid.Column="0" Grid.Row="0" Spacing="1">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Classes="fieldLabel" Text="CURVATURE" />
                                            <TextBlock Grid.Column="1" Classes="valueBadge"
                                                       Text="{Binding #SliderCurvature.Value, StringFormat={}{0:0.000}}" />
                                        </Grid>
                                        <Slider x:Name="SliderCurvature"
                                                Minimum="0" Maximum="0.05"
                                                ValueChanged="SliderCurvature_OnValueChanged" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Grid.Row="0" Spacing="1">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Classes="fieldLabel" Text="VIGNETTE" />
                                            <TextBlock Grid.Column="1" Classes="valueBadge"
                                                       Text="{Binding #SliderVignette.Value, StringFormat={}{0:0.000}}" />
                                        </Grid>
                                        <Slider x:Name="SliderVignette"
                                                Minimum="0" Maximum="1.0"
                                                ValueChanged="SliderVignette_OnValueChanged" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="4" Grid.Row="0" Spacing="1">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Classes="fieldLabel" Text="SCANLINE" />
                                            <TextBlock Grid.Column="1" Classes="valueBadge"
                                                       Text="{Binding #SliderScanline.Value, StringFormat={}{0:0.000}}" />
                                        </Grid>
                                        <Slider x:Name="SliderScanline"
                                                Minimum="-5.0" Maximum="5.0"
                                                ValueChanged="SliderScanline_OnValueChanged" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="0" Grid.Row="1" Spacing="1">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Classes="fieldLabel" Text="ABERRATION" />
                                            <TextBlock Grid.Column="1" Classes="valueBadge"
                                                       Text="{Binding #SliderAberration.Value, StringFormat={}{0:0.000}}" />
                                        </Grid>
                                        <Slider x:Name="SliderAberration"
                                                Minimum="0.0" Maximum="2.0"
                                                ValueChanged="SliderAberration_OnValueChanged" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Grid.Row="1" Spacing="1">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Classes="fieldLabel" Text="BLOOM" />
                                            <TextBlock Grid.Column="1" Classes="valueBadge"
                                                       Text="{Binding #SliderBloom.Value, StringFormat={}{0:0.000}}" />
                                        </Grid>
                                        <Slider x:Name="SliderBloom"
                                                Minimum="0.0" Maximum="2.0"
                                                ValueChanged="SliderBloom_OnValueChanged" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="4" Grid.Row="1" Spacing="1">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Classes="fieldLabel" Text="MASK" />
                                            <TextBlock Grid.Column="1" Classes="valueBadge"
                                                       Text="{Binding #SliderMask.Value, StringFormat={}{0:0.000}}" />
                                        </Grid>
                                        <Slider x:Name="SliderMask"
                                                Minimum="0.0" Maximum="2.0"
                                                ValueChanged="SliderMask_OnValueChanged" />
                                    </StackPanel>

                                    <!-- The mask's geometry, under its strength. -->
                                    <StackPanel Grid.Column="4" Grid.Row="2" Spacing="1">
                                        <TextBlock Classes="fieldLabel" Text="MASK TYPE" />
                                        <ComboBox Name="ComboMaskType"
                                                  HorizontalAlignment="Stretch"
                                                  SelectionChanged="MaskType_SelectionChanged">
                                            <ComboBoxItem>Aperture grille</ComboBoxItem>
                                            <ComboBoxItem>Slot mask</ComboBoxItem>
                                            <ComboBoxItem>Shadow mask</ComboBoxItem>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <!-- Match the same three-column geometry as the six sliders above.
                                     Noise therefore has exactly the same width as every other slider. -->
                                <Grid ColumnDefinitions="*,18,*,18,*" ColumnSpacing="0">
                                    <StackPanel Name="PanelNoiseSlider" Grid.Column="0" Spacing="1">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Classes="fieldLabel" Text="NOISE" />
                                            <TextBlock Grid.Column="1" Classes="valueBadge"
                                                       Text="{Binding #SliderNoise.Value, StringFormat={}{0:0.000}}" />
                                        </Grid>
                                        <Slider x:Name="SliderNoise"
                                                Minimum="0.0" Maximum="1.0"
                                                ValueChanged="SliderNoise_OnValueChanged" />
                                    </StackPanel>

                                    <Button Grid.Column="2"
                                            Name="ButtonDefaultGLValues"
                                            Classes="compact"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Click="ButtonDefaultGLValues_OnClick"
                                            Content="Set default values" />
                                    
                                    <CheckBox Grid.Column="4"
                                              Name="chkShowBorders"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              IsCheckedChanged="ChkShowBorders_OnIsCheckedChanged">
                                        Show borders
                                    </CheckBox>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- PICTURE: the filters and corrections between the machine and the screen, and
                 the ready-made looks that set them all at once. They left the Video tab so
                 that tab keeps to the monitor and the CRT effects, and so that a newcomer
                 finds one control — the preset — before six. -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Svg Path="avares://ASE/Assets/Icons/image.svg" Width="18" Height="18" Margin="0,2,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="Picture" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>

                <StackPanel Classes="settingsContent" Spacing="12">

                    <Border Classes="card">
                        <StackPanel Spacing="10">
                            <StackPanel Spacing="3">
                                <TextBlock Classes="section" Text="Look" />
                                <TextBlock Classes="description"
                                           Text="Pick a ready-made look, or set the options below yourself. The moment you change one, the preset reads Custom." />
                            </StackPanel>

                            <Grid ColumnDefinitions="160,*" ColumnSpacing="18">
                                <TextBlock Grid.Column="0" Classes="fieldLabel" VerticalAlignment="Center" Text="PRESET" />
                                <ComboBox Grid.Column="1"
                                          Name="ComboPicturePreset"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="PicturePreset_SelectionChanged">
                                    <ComboBoxItem>Atari monitor</ComboBoxItem>
                                    <ComboBoxItem>Home TV</ComboBoxItem>
                                    <ComboBoxItem>Pixel perfect</ComboBoxItem>
                                    <ComboBoxItem>Enhanced</ComboBoxItem>
                                    <ComboBoxItem>Custom</ComboBoxItem>
                                </ComboBox>
                            </Grid>

                            <TextBlock Name="TextPresetDescription" Classes="description" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- The options, in the order the picture goes through them. -->
                    <Border Classes="card">
                        <StackPanel Spacing="10">
                            <StackPanel Spacing="3">
                                <TextBlock Classes="section" Text="Picture options" />
                                <TextBlock Classes="description"
                                           Text="Applied in this order, each independent of the rest, and all off by default. The CRT effects themselves are on the Video tab." />
                            </StackPanel>

                            <Grid ColumnDefinitions="160,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="12">

                                <TextBlock Grid.Column="0" Grid.Row="0" Classes="fieldLabel" VerticalAlignment="Center" Text="VIDEO SIGNAL" />
                                <ComboBox Grid.Column="1" Grid.Row="0" Name="ComboVideoSignal" HorizontalAlignment="Stretch"
                                          SelectionChanged="VideoSignal_SelectionChanged">
                                    <ComboBoxItem>RGB monitor</ComboBoxItem>
                                    <ComboBoxItem>Composite television</ComboBoxItem>
                                    <ComboBoxItem>RF (aerial television)</ComboBoxItem>
                                </ComboBox>
                                <Button Grid.Column="2" Grid.Row="0" Classes="infoHint" VerticalAlignment="Center">
                                    <Svg Path="avares://ASE/Assets/Icons/info-circle.svg" Width="15" Height="15" />
                                    <ToolTip.Tip>
                                        <StackPanel MaxWidth="400" Spacing="7">
                                            <TextBlock TextWrapping="Wrap"
                                                       Text="What the ST is connected to. RGB shows the machine's signal almost directly. Composite combines luminance and colour into a single signal, which the television has to separate again; this softens fine detail, smears colour and can produce artefacts in dithered areas. RF sends that signal through a modulator and the television's tuner, so the picture is usually softer still and the artefacts more visible. Each signal type can be adjusted in the configuration file with three parameters: LumaSoftness, ChromaRadius and Artefacts. The manual includes examples." />
                                            <TextBlock TextWrapping="Wrap"
                                                       Text="With a television signal the colour is already blended, so Colorize dithering and Edge smoothing have nothing left to work on and are bypassed. Anti-aliasing still applies." />
                                            <TextBlock TextWrapping="Wrap"
                                                       Opacity="0.75"
                                                       Text="Cheap: one pass at the emulated resolution." />
                                        </StackPanel>
                                    </ToolTip.Tip>
                                </Button>

                                <TextBlock Grid.Column="0" Grid.Row="1" Classes="fieldLabel" VerticalAlignment="Center" Text="COLORIZE DITHERING" />
                                <CheckBox Grid.Column="1" Grid.Row="1" Name="chkColorizeDithering" VerticalAlignment="Center"
                                          IsCheckedChanged="ChkColorizeDithering_OnIsCheckedChanged">
                                    Blend dithering patterns into real colours and gradients
                                </CheckBox>
                                <Button Grid.Column="2" Grid.Row="1" Classes="infoHint" VerticalAlignment="Center">
                                    <Svg Path="avares://ASE/Assets/Icons/info-circle.svg" Width="15" Height="15" />
                                    <ToolTip.Tip>
                                        <StackPanel MaxWidth="400" Spacing="7">
                                            <TextBlock TextWrapping="Wrap"
                                                       Text="The ST puts 16 colours on screen out of 512 or 4096, so gradients and polygon shading are drawn as two-colour patterns. This paints the tone each pattern stood for as a real RGB colour, outside the ST palette, the tone a CRT of the day merged it into." />
                                            <TextBlock TextWrapping="Wrap"
                                                       Text="A second stage then merges the bands of a dithered gradient into a continuous ramp, so a sky drawn in two colours comes out with hundreds. Text, sprite outlines and edges are left as the ST drew them." />
                                            <TextBlock TextWrapping="Wrap"
                                                       Opacity="0.75"
                                                       Text="By far the most demanding thing ASE draws: leave it off on a Raspberry Pi or a similar single-board computer." />
                                        </StackPanel>
                                    </ToolTip.Tip>
                                </Button>

                                <TextBlock Grid.Column="0" Grid.Row="2" Classes="fieldLabel" VerticalAlignment="Center" Text="EDGE SMOOTHING" />
                                <ComboBox Grid.Column="1" Grid.Row="2" Name="ComboEdgeSmoothing" HorizontalAlignment="Stretch"
                                          SelectionChanged="EdgeSmoothing_SelectionChanged">
                                    <ComboBoxItem>Off</ComboBoxItem>
                                    <ComboBoxItem>SuperEagle</ComboBoxItem>
                                    <ComboBoxItem>xBR</ComboBoxItem>
                                </ComboBox>
                                <Button Grid.Column="2" Grid.Row="2" Classes="infoHint" VerticalAlignment="Center">
                                    <Svg Path="avares://ASE/Assets/Icons/info-circle.svg" Width="15" Height="15" />
                                    <ToolTip.Tip>
                                        <StackPanel MaxWidth="400" Spacing="7">
                                            <TextBlock TextWrapping="Wrap"
                                                       Text="Redraws the picture at twice the resolution with the shape of every edge read from its neighbourhood, so diagonals and curves stop being staircases. SuperEagle is the filter MAME and the libretro front-ends have shipped for years; xBR (Hyllian) measures the edge direction more carefully and handles curves better, usually the one to pick." />
                                            <TextBlock TextWrapping="Wrap"
                                                       Text="Flat areas and straight edges are left exactly as the ST drew them. Applied after the dithering colorization, so the two can be used together." />
                                            <TextBlock TextWrapping="Wrap"
                                                       Opacity="0.75"
                                                       Text="Demanding: the pass covers four times the pixels of the emulated screen." />
                                        </StackPanel>
                                    </ToolTip.Tip>
                                </Button>

                                <TextBlock Grid.Column="0" Grid.Row="3" Classes="fieldLabel" VerticalAlignment="Center" Text="ANTI-ALIASING" />
                                <ComboBox Grid.Column="1" Grid.Row="3" Name="ComboAntiAliasing" HorizontalAlignment="Stretch"
                                          SelectionChanged="AntiAliasing_SelectionChanged">
                                    <ComboBoxItem>Off</ComboBoxItem>
                                    <ComboBoxItem>FXAA</ComboBoxItem>
                                    <ComboBoxItem>SMAA</ComboBoxItem>
                                </ComboBox>
                                <Button Grid.Column="2" Grid.Row="3" Classes="infoHint" VerticalAlignment="Center">
                                    <Svg Path="avares://ASE/Assets/Icons/info-circle.svg" Width="15" Height="15" />
                                    <ToolTip.Tip>
                                        <StackPanel MaxWidth="400" Spacing="7">
                                            <TextBlock TextWrapping="Wrap"
                                                       Text="Smooths the staircase edges of lines and polygons what 3D games draw, by blending along every edge it finds, the way a game's own anti-aliasing option does. FXAA (NVIDIA) is the quick one: soft, and it also softens text and dithering a little. SMAA (Jimenez et al.) reconstructs the shape of each edge before blending, so lines come out cleaner and flat detail stays closer to the original." />
                                            <TextBlock TextWrapping="Wrap"
                                                       Text="Applied after the two options above, so all three can be combined freely. There is no geometry left for MSAA or SSAA to work on: the ST drew the pixels itself." />
                                            <TextBlock TextWrapping="Wrap"
                                                       Opacity="0.75"
                                                       Text="Moderate cost: one pass for FXAA, three for SMAA." />
                                        </StackPanel>
                                    </ToolTip.Tip>
                                </Button>

                                <TextBlock Grid.Column="0" Grid.Row="4" Classes="fieldLabel" VerticalAlignment="Center" Text="SCALING" />
                                <ComboBox Grid.Column="1" Grid.Row="4" Name="ComboScaling" HorizontalAlignment="Stretch"
                                          SelectionChanged="Scaling_SelectionChanged">
                                    <ComboBoxItem>Smooth</ComboBoxItem>
                                    <ComboBoxItem>Sharp</ComboBoxItem>
                                    <ComboBoxItem>Integer (sharp, whole pixels per line)</ComboBoxItem>
                                </ComboBox>
                                <Button Grid.Column="2" Grid.Row="4" Classes="infoHint" VerticalAlignment="Center">
                                    <Svg Path="avares://ASE/Assets/Icons/info-circle.svg" Width="15" Height="15" />
                                    <ToolTip.Tip>
                                        <StackPanel MaxWidth="400" Spacing="7">
                                            <TextBlock TextWrapping="Wrap"
                                                       Text="How the picture is stretched to the window. Smooth is the bilinear filter ASE always used: soft at any scale. Sharp keeps every pixel crisp whatever the window size, blending only the single screen pixel where two ST pixels meet, so there is no shimmer either. Integer goes one step further and letterboxes the picture so that each ST line is a whole number of screen pixels." />
                                            <TextBlock TextWrapping="Wrap"
                                                       Opacity="0.75"
                                                       Text="Sharp only shows where the window gives the picture more than one screen pixel per ST pixel. Across, that takes full screen or a large window; down, most windows have the room, so look at the top and bottom edges of things first." />
                                            <TextBlock TextWrapping="Wrap"
                                                       Opacity="0.75"
                                                       Text="Free: it only changes how the final pass samples." />
                                        </StackPanel>
                                    </ToolTip.Tip>
                                </Button>

                                <TextBlock Grid.Column="0" Grid.Row="5" Classes="fieldLabel" VerticalAlignment="Center" Text="PERSISTENCE" />
                                <Grid Grid.Column="1" Grid.Row="5" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <Slider Grid.Column="0" x:Name="SliderPersistence" VerticalAlignment="Center"
                                            Minimum="0" Maximum="50" TickFrequency="5" IsSnapToTickEnabled="True"
                                            ValueChanged="SliderPersistence_OnValueChanged" />
                                    <TextBlock Grid.Column="1" Classes="valueBadge" VerticalAlignment="Center"
                                               Text="{Binding #SliderPersistence.Value, StringFormat={}{0:0}%}" />
                                </Grid>
                                <Button Grid.Column="2" Grid.Row="5" Classes="infoHint" VerticalAlignment="Center">
                                    <Svg Path="avares://ASE/Assets/Icons/info-circle.svg" Width="15" Height="15" />
                                    <ToolTip.Tip>
                                        <StackPanel MaxWidth="400" Spacing="7">
                                            <TextBlock TextWrapping="Wrap"
                                                       Text="Blends each frame with the previous one, as the glow of a CRT's phosphor did. Many ST pictures and demos alternate two frames at 50 Hz to show more colours than the palette allows, and some games draw a sprite every other frame to make it translucent: on a flat screen those flicker, with persistence they show as the steady mix they were designed as. 50% is a straight average of the two frames." />
                                            <TextBlock TextWrapping="Wrap"
                                                       Opacity="0.75"
                                                       Text="Anything above 0 leaves a short trail behind whatever moves; 20-30% is a good compromise for a general TV look, 50% for flicker pictures." />
                                        </StackPanel>
                                    </ToolTip.Tip>
                                </Button>
                            </Grid>

                            <TextBlock Name="TextSignalHint" Classes="description" TextWrapping="Wrap" IsVisible="False"
                                       Text="With a television signal the colour is already blended by the set, so Colorize dithering and Edge smoothing have nothing to work on and are bypassed." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- INPUT -->
            <TabItem x:Name="TabInput">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Svg Path="avares://ASE/Assets/Icons/joystick.svg" Width="18" Height="18" Margin="0,2,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="Input" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>

                    <StackPanel Classes="settingsContent" Spacing="12">
                    
                        <Border Classes="card">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="section" Text="Atari ports" />
                                    <TextBlock Classes="description" Text="Devices connected to the Atari ports." />
                                </StackPanel>

                                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10" HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                                        <Svg Path="avares://ASE/Assets/Icons/mouse.svg" Margin="0,0,4,0"></Svg>
                                        <Svg Path="avares://ASE/Assets/Icons/joystick.svg"></Svg>
                                    </StackPanel>
                                    <ComboBox Name="ComboPort0" Grid.Column="1" Width="200">
                                        <ComboBoxItem>Disconnected</ComboBoxItem>
                                        <ComboBoxItem>Mouse</ComboBoxItem>
                                        <ComboBoxItem>Keys and Gamepad</ComboBoxItem>
                                        <ComboBoxItem>Keys only</ComboBoxItem>
                                        <ComboBoxItem>Gamepad only</ComboBoxItem>
                                    </ComboBox>
                                    <StackPanel Orientation="Horizontal" Grid.Column="3" VerticalAlignment="Center">
                                        <Svg Path="avares://ASE/Assets/Icons/joystick.svg"></Svg>
                                    </StackPanel>
                                    <!-- The item stays so both combos share the PortDevices order:
                                         the IKBD decodes a mouse on port 0 only. -->
                                    <ComboBox Name="ComboPort1" Grid.Column="4" Width="200">
                                        <ComboBoxItem>Disconnected</ComboBoxItem>
                                        <ComboBoxItem IsEnabled="False" ToolTip.ShowOnDisabled="True"
                                                      ToolTip.Tip="The ST reads a mouse on port 0 only.">Mouse</ComboBoxItem>
                                        <ComboBoxItem>Keys and Gamepad</ComboBoxItem>
                                        <ComboBoxItem>Keys only</ComboBoxItem>
                                        <ComboBoxItem>Gamepad only</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>
                    
                        <Border Classes="card">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="section" Text="Mouse" />
                                    <TextBlock Classes="description" Text="How far the ST pointer travels for the same movement of your mouse." />
                                </StackPanel>

                                <!--
                                  The slider edits Config.MousePointerSpeed, not the stored
                                  MouseSensitivity: the emulator divides by that one, so its number
                                  grows as the pointer gets slower, which reads backwards on a
                                  settings page. Speed runs low to high, left to right, matching
                                  the slow/fast cursor icons at either end.
                                -->
                                <Grid ColumnDefinitions="32,*,32" ColumnSpacing="10">
                                    <Svg Path="avares://ASE/Assets/Icons/mousecursorslow.svg"
                                         Width="22" Height="22" Grid.Column="0"
                                         VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Classes="fieldLabel" Text="Pointer speed" />
                                            <TextBlock Grid.Column="1" Classes="valueBadge"
                                                       Text="{Binding #SliderMouseSpeed.Value, StringFormat=×{0:0.0}}" />
                                        </Grid>
                                        <Slider x:Name="SliderMouseSpeed"
                                                Value="{Binding MousePointerSpeed, Mode=TwoWay}"
                                                Minimum="0.4" Maximum="4.0"
                                                TickFrequency="0.2"
                                                IsSnapToTickEnabled="True" />
                                    </StackPanel>

                                    <Svg Path="avares://ASE/Assets/Icons/mousecursorfast.svg"
                                         Width="22" Height="22" Grid.Column="2"
                                         VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Grid ColumnDefinitions="*,12,*">
                            <Border Grid.Column="0" Classes="card">
                                <StackPanel Spacing="14">
                                    <StackPanel Spacing="3">
                                        <TextBlock Classes="section" Text="Joystick mapped to keys" />
                                        <TextBlock Classes="description" Text="Keyboard controls for joystick directions and fire." />
                                    </StackPanel>

                                    <Grid ColumnDefinitions="*,Auto,Auto"
                                          RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                          ColumnSpacing="10" RowSpacing="8">
                                        <TextBlock Grid.Column="0" Grid.Row="0" VerticalAlignment="Center" Text="Up" />
                                        <Border Grid.Column="1" Grid.Row="0" Classes="keycap">
                                            <TextBlock x:Name="TextUp" FontWeight="SemiBold" Text="8" />
                                        </Border>
                                        <Button x:Name="btnRedefineUp" Grid.Column="2" Grid.Row="0" Classes="compact" Click="OnRedefine">Redefine</Button>

                                        <TextBlock Grid.Column="0" Grid.Row="1" VerticalAlignment="Center" Text="Down" />
                                        <Border Grid.Column="1" Grid.Row="1" Classes="keycap">
                                            <TextBlock x:Name="TextDown" FontWeight="SemiBold" Text="8" />
                                        </Border>
                                        <Button x:Name="btnRedefineDown" Grid.Column="2" Grid.Row="1" Classes="compact" Click="OnRedefine">Redefine</Button>

                                        <TextBlock Grid.Column="0" Grid.Row="2" VerticalAlignment="Center" Text="Left" />
                                        <Border Grid.Column="1" Grid.Row="2" Classes="keycap">
                                            <TextBlock x:Name="TextLeft" FontWeight="SemiBold" Text="8" />
                                        </Border>
                                        <Button x:Name="btnRedefineLeft" Grid.Column="2" Grid.Row="2" Classes="compact" Click="OnRedefine">Redefine</Button>

                                        <TextBlock Grid.Column="0" Grid.Row="3" VerticalAlignment="Center" Text="Right" />
                                        <Border Grid.Column="1" Grid.Row="3" Classes="keycap">
                                            <TextBlock x:Name="TextRight" FontWeight="SemiBold" Text="8" />
                                        </Border>
                                        <Button x:Name="btnRedefineRight" Grid.Column="2" Grid.Row="3" Classes="compact" Click="OnRedefine">Redefine</Button>

                                        <TextBlock Grid.Column="0" Grid.Row="4" VerticalAlignment="Center" Text="Fire" />
                                        <Border Grid.Column="1" Grid.Row="4" Classes="keycap">
                                            <TextBlock x:Name="TextFire" FontWeight="SemiBold" Text="8" />
                                        </Border>
                                        <Button x:Name="btnRedefineFire" Grid.Column="2" Grid.Row="4" Classes="compact" Click="OnRedefine">Redefine</Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Classes="card">
                                <StackPanel Spacing="14">
                                    <StackPanel Spacing="3">
                                        <TextBlock Classes="section" Text="Gamepad buttons" />
                                        <TextBlock Classes="description" TextWrapping="Wrap" Text="Assign common Atari actions and keys to gamepad buttons. Back 5 s, Back 10 s and Time warp… go back in the game." />
                                    </StackPanel>

                                    <Grid ColumnDefinitions="Auto,*,18,Auto,*"
                                          RowDefinitions="Auto,Auto,Auto,Auto"
                                          ColumnSpacing="8" RowSpacing="9">
                                        <TextBlock Grid.Column="0" Grid.Row="0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Y" />
                                        <ComboBox Name="ComboY" Grid.Column="1" Grid.Row="0" HorizontalAlignment="Stretch">
                                            <ComboBoxItem>None</ComboBoxItem><ComboBoxItem>Fire</ComboBoxItem><ComboBoxItem>Space</ComboBoxItem><ComboBoxItem>Up</ComboBoxItem><ComboBoxItem>Y</ComboBoxItem><ComboBoxItem>N</ComboBoxItem><ComboBoxItem>T</ComboBoxItem><ComboBoxItem>Back 5 s</ComboBoxItem><ComboBoxItem>Back 10 s</ComboBoxItem><ComboBoxItem>Time warp…</ComboBoxItem>
                                        </ComboBox>

                                        <TextBlock Grid.Column="0" Grid.Row="1" VerticalAlignment="Center" FontWeight="SemiBold" Text="X" />
                                        <ComboBox Name="ComboX" Grid.Column="1" Grid.Row="1" HorizontalAlignment="Stretch">
                                            <ComboBoxItem>None</ComboBoxItem><ComboBoxItem>Fire</ComboBoxItem><ComboBoxItem>Space</ComboBoxItem><ComboBoxItem>Up</ComboBoxItem><ComboBoxItem>Y</ComboBoxItem><ComboBoxItem>N</ComboBoxItem><ComboBoxItem>T</ComboBoxItem><ComboBoxItem>Back 5 s</ComboBoxItem><ComboBoxItem>Back 10 s</ComboBoxItem><ComboBoxItem>Time warp…</ComboBoxItem>
                                        </ComboBox>

                                        <TextBlock Grid.Column="0" Grid.Row="2" VerticalAlignment="Center" FontWeight="SemiBold" Text="B" />
                                        <ComboBox Name="ComboB" Grid.Column="1" Grid.Row="2" HorizontalAlignment="Stretch">
                                            <ComboBoxItem>None</ComboBoxItem><ComboBoxItem>Fire</ComboBoxItem><ComboBoxItem>Space</ComboBoxItem><ComboBoxItem>Up</ComboBoxItem><ComboBoxItem>Y</ComboBoxItem><ComboBoxItem>N</ComboBoxItem><ComboBoxItem>T</ComboBoxItem><ComboBoxItem>Back 5 s</ComboBoxItem><ComboBoxItem>Back 10 s</ComboBoxItem><ComboBoxItem>Time warp…</ComboBoxItem>
                                        </ComboBox>

                                        <TextBlock Grid.Column="0" Grid.Row="3" VerticalAlignment="Center" FontWeight="SemiBold" Text="A" />
                                        <ComboBox Name="ComboA" Grid.Column="1" Grid.Row="3" HorizontalAlignment="Stretch">
                                            <ComboBoxItem>None</ComboBoxItem><ComboBoxItem>Fire</ComboBoxItem><ComboBoxItem>Space</ComboBoxItem><ComboBoxItem>Up</ComboBoxItem><ComboBoxItem>Y</ComboBoxItem><ComboBoxItem>N</ComboBoxItem><ComboBoxItem>T</ComboBoxItem><ComboBoxItem>Back 5 s</ComboBoxItem><ComboBoxItem>Back 10 s</ComboBoxItem><ComboBoxItem>Time warp…</ComboBoxItem>
                                        </ComboBox>

                                        <TextBlock Grid.Column="3" Grid.Row="0" VerticalAlignment="Center" FontWeight="SemiBold" Text="LB" />
                                        <ComboBox Name="ComboLB" Grid.Column="4" Grid.Row="0" HorizontalAlignment="Stretch">
                                            <ComboBoxItem>None</ComboBoxItem><ComboBoxItem>Fire</ComboBoxItem><ComboBoxItem>Space</ComboBoxItem><ComboBoxItem>Up</ComboBoxItem><ComboBoxItem>Y</ComboBoxItem><ComboBoxItem>N</ComboBoxItem><ComboBoxItem>T</ComboBoxItem><ComboBoxItem>Back 5 s</ComboBoxItem><ComboBoxItem>Back 10 s</ComboBoxItem><ComboBoxItem>Time warp…</ComboBoxItem>
                                        </ComboBox>

                                        <TextBlock Grid.Column="3" Grid.Row="1" VerticalAlignment="Center" FontWeight="SemiBold" Text="RB" />
                                        <ComboBox Name="ComboRB" Grid.Column="4" Grid.Row="1" HorizontalAlignment="Stretch">
                                            <ComboBoxItem>None</ComboBoxItem><ComboBoxItem>Fire</ComboBoxItem><ComboBoxItem>Space</ComboBoxItem><ComboBoxItem>Up</ComboBoxItem><ComboBoxItem>Y</ComboBoxItem><ComboBoxItem>N</ComboBoxItem><ComboBoxItem>T</ComboBoxItem><ComboBoxItem>Back 5 s</ComboBoxItem><ComboBoxItem>Back 10 s</ComboBoxItem><ComboBoxItem>Time warp…</ComboBoxItem>
                                        </ComboBox>

                                        <TextBlock Grid.Column="3" Grid.Row="2" VerticalAlignment="Center" FontWeight="SemiBold" Text="LS" />
                                        <ComboBox Name="ComboLS" Grid.Column="4" Grid.Row="2" HorizontalAlignment="Stretch">
                                            <ComboBoxItem>None</ComboBoxItem><ComboBoxItem>Fire</ComboBoxItem><ComboBoxItem>Space</ComboBoxItem><ComboBoxItem>Up</ComboBoxItem><ComboBoxItem>Y</ComboBoxItem><ComboBoxItem>N</ComboBoxItem><ComboBoxItem>T</ComboBoxItem><ComboBoxItem>Back 5 s</ComboBoxItem><ComboBoxItem>Back 10 s</ComboBoxItem><ComboBoxItem>Time warp…</ComboBoxItem>
                                        </ComboBox>

                                        <TextBlock Grid.Column="3" Grid.Row="3" VerticalAlignment="Center" FontWeight="SemiBold" Text="RS" />
                                        <ComboBox Name="ComboRS" Grid.Column="4" Grid.Row="3" HorizontalAlignment="Stretch">
                                            <ComboBoxItem>None</ComboBoxItem><ComboBoxItem>Fire</ComboBoxItem><ComboBoxItem>Space</ComboBoxItem><ComboBoxItem>Up</ComboBoxItem><ComboBoxItem>Y</ComboBoxItem><ComboBoxItem>N</ComboBoxItem><ComboBoxItem>T</ComboBoxItem><ComboBoxItem>Back 5 s</ComboBoxItem><ComboBoxItem>Back 10 s</ComboBoxItem><ComboBoxItem>Time warp…</ComboBoxItem>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                
            </TabItem>

            <!-- Hard disk -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Svg Path="avares://ASE/Assets/Icons/hdd.svg" Width="18" Height="18" Margin="0,2,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="Storage" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>

                <StackPanel Classes="settingsContent" Spacing="12">
                    <Border Classes="card">
                        <StackPanel Spacing="16">

                                <StackPanel Spacing="2">
                                    <TextBlock Classes="section" Text="Hard disk emulation" />
                                    <TextBlock Classes="description"
                                                Text="Mount a folder of this computer as a GEMDOS drive or/and attach an ACSI hard disk image. Changes require reset." />
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Classes="fieldLabel" Text="GEMDOS DRIVE  ·  HOST FOLDER" />
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <CheckBox Name="EnableGemDos" />
                                        <TextBox Grid.Column="1" Name="TextGEMDOSDir" />
                                        <Button Grid.Column="2" Classes="compact" Content="Browse…" Click="OnBrowseGemdosDirClick" />
                                    </Grid>
                                    <TextBlock Classes="description"
                                               Text="The folder appears as a hard drive on the GEM desktop, taking the first letter after the ACSI image's partitions." />
                                </StackPanel>

                                <Border Height="1" Background="#404040" Margin="16,8"/>

                                <StackPanel Spacing="6">
                                    <TextBlock Classes="fieldLabel" Text="ACSI HARD DISK IMAGE" />
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <CheckBox Name="EnableACSI" />
                                        <TextBox Grid.Column="1" Name="TextACSIDir" />
                                        <Button Grid.Column="2" Classes="compact" Content="Browse…" Click="OnBrowseAcsiImageClick" />
                                    </Grid>
                                    <TextBlock Classes="description"
                                               Text="HD image attached to the ACSI bus. Full device emulation." />
                                </StackPanel>

                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                    <CheckBox Grid.Column="0" Name="ChkBootFromHardDisk" Content="Boot from the hard disk (ACSI image only)" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="Reinstall driver" Click="OnReinstallDriverClick"
                                            ToolTip.Tip="Writes the ASE HD driver to an existing image, replacing whatever driver it has." />
                                    <Button Grid.Column="2" Content="Create image" Click="OnCreateAcsiImageClick" />
                                </Grid>


                        </StackPanel>
                        </Border>
                </StackPanel>
            </TabItem>

            <!-- DIRECTORIES -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Svg Path="avares://ASE/Assets/Icons/folder.svg" Width="18" Height="18" Margin="0,2,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="Folders" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>


                    <StackPanel Classes="settingsContent">
                        <Border Classes="card">
                            <StackPanel Spacing="15">
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="section" Text="Default directories" />
                                    <TextBlock Classes="description" Text="Choose where ASE stores and looks for frequently used files." />
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Classes="fieldLabel" Text="SCREENSHOTS  ·  SHIFT+F11" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <TextBox Grid.Column="0" Name="TextScreenshotsDir" />
                                        <Button Grid.Column="1" Classes="compact" Content="Browse…" Click="OnBrowseScreenshotsDirClick" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Classes="fieldLabel" Text="SNAPSHOTS  ·  F11" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <TextBox Grid.Column="0" Name="TextSnapshotsDir" />
                                        <Button Grid.Column="1" Classes="compact" Content="Browse…" Click="OnBrowseSnapshotsDirClick" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Classes="fieldLabel" Text="DISK IMAGES" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <TextBox Grid.Column="0" Name="TextDiskImagesDir" />
                                        <Button Grid.Column="1" Classes="compact" Content="Browse…" Click="OnBrowseDiskImagesDirClick" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Classes="fieldLabel" Text="TOS ROMS" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <TextBox Grid.Column="0" Name="TextTOSRomsDir" />
                                        <Button Grid.Column="1" Classes="compact" Content="Browse…" Click="OnBrowseTOSRomsDirClick" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
            </TabItem>
            
            <!-- MIDI -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Svg Path="avares://ASE/Assets/Icons/music-note-beamed.svg" Width="18" Height="18" Margin="0,2,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="MIDI" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>

                <StackPanel Classes="settingsContent" Spacing="12">
                    <Border Classes="card">
                        <StackPanel Spacing="12">
                            <StackPanel Grid.Column="0" Spacing="3">
                                <TextBlock Classes="section" Text="MIDI" />
                                <TextBlock Classes="description" Text="Choose the emulated MIDI options." />
                            </StackPanel>
                            <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto" RowSpacing="12" ColumnSpacing="18">

                                <TextBlock Grid.Row="0" Grid.Column="0" Classes="fieldLabel" VerticalAlignment="Center" Text="EMULATION" />
                                <ComboBox Name="ComboMidiEmulation"
                                          Grid.Row="0" Grid.Column="1"
                                          MaxDropDownHeight="140"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center"
                                          SelectedIndex="{Binding MidiEmulation, Mode=TwoWay}"
                                          SelectionChanged="MidiEmulation_SelectionChanged">
                                    <ComboBoxItem>Not emulated</ComboBoxItem>
                                    <ComboBoxItem>System managed MIDI</ComboBoxItem>
                                    <ComboBoxItem>Built-in Roland MT-32 emulation</ComboBoxItem>
                                </ComboBox>

                                <!-- Options for System managed. Both option grids share row 1:
                                     only the one belonging to the selected mode is visible
                                     (ConfigurationWindow.UpdateMidiVisibility). -->
                                <Grid Name="GridMidiSystem"
                                      Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                      IsVisible="False"
                                      ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="12" ColumnSpacing="18">
                                    <!-- MIDI In -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="fieldLabel" VerticalAlignment="Center" Text="MIDI IN" />
                                    <ComboBox Name="ComboMidiIn"
                                              Grid.Row="0" Grid.Column="1"
                                              MaxDropDownHeight="220"
                                              HorizontalAlignment="Stretch" />
                                    <!-- MIDI Out -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="fieldLabel" VerticalAlignment="Center" Text="MIDI OUT" />
                                    <ComboBox Name="ComboMidiOut"
                                              Grid.Row="1" Grid.Column="1"
                                              MaxDropDownHeight="220"
                                              HorizontalAlignment="Stretch" />

                                    <TextBlock Grid.Row="2" Grid.Column="1"
                                               Classes="description"
                                               Text="Ports published by the operating system. The ST MIDI OUT is sent to the output port, and whatever arrives at the input port reaches its MIDI IN." />
                                </Grid>

                                <!-- Options for Built-in MT32 emulation -->
                                <Grid Name="GridMidiMt32"
                                      Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                      IsVisible="False"
                                      ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12" ColumnSpacing="18">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="fieldLabel" VerticalAlignment="Center" Text="MT32 ROMS" />
                                    <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <TextBox Grid.Column="0" Name="TextMt32RomDir" />
                                        <Button Grid.Column="1" Classes="compact" Content="Browse…" Click="OnBrowseMt32RomsClick" />
                                    </Grid>

                                    <TextBlock Grid.Row="1" Grid.Column="1"
                                               Classes="description"
                                               Text="Folder with the Roland control and PCM ROM images, which are not supplied with ASE. Their file names do not matter, I'll identify the ROMs automatically." />

                                    <!-- The module's volume knob: applied live, no reset needed. -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" Classes="fieldLabel" VerticalAlignment="Center" Text="VOLUME" />
                                    <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <!-- Maximum comes from Mt32Backend.MaxVolume, assigned in the
                                             constructor: the knob's ceiling belongs with the mixer that
                                             enforces it, and x:Static cannot feed this double property. -->
                                        <Slider Grid.Column="0" x:Name="SliderMt32Volume"
                                                Minimum="0"
                                                TickFrequency="5" IsSnapToTickEnabled="True"
                                                VerticalAlignment="Center"
                                                ValueChanged="SliderMt32Volume_OnValueChanged" />
                                        <TextBlock Grid.Column="1" Classes="valueBadge" VerticalAlignment="Center"
                                                   Text="{Binding #SliderMt32Volume.Value, StringFormat={}{0:0}%}" />
                                    </Grid>

                                    <TextBlock Grid.Row="3" Grid.Column="1"
                                               Classes="description"
                                               Text="Level of the emulated module in the mix, like the volume knob on the real Roland. Open the MT32 Toolbox to change while running." />
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>
            
        </TabControl>

        <!-- Footer -->
        <Border Grid.Row="2"
                Classes="dialogFooter"
                Margin="0,12,0,0"
                Padding="24,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button Content="Cancel"
                        HorizontalContentAlignment="Center"
                        Click="OnCancelClick"
                        Width="100" />
                <Button Content="OK"
                        Classes="accent"
                        Width="100"
                        HorizontalContentAlignment="Center"
                        Click="OnOkClick" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
