<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:svg="clr-namespace:Avalonia.Svg;assembly=Svg.Controls.Avalonia"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		mc:Ignorable="d"
        xmlns:local="using:ASE"
        x:Class="ASE.FileList"
        x:DataType="local:FileList"
        Title="File List"
        CanResize="False"
		WindowStartupLocation="CenterScreen"
		UseLayoutRounding="True"
        Width="400" Height="360"
        >

	<Grid RowDefinitions="Auto,*,Auto" Margin="16,12">

		<StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
			<Svg Path="avares://ASE/Assets/Icons/disk.svg"
			     Width="18" Height="18"
			     VerticalAlignment="Center"/>
			<TextBlock Classes="section" VerticalAlignment="Center" Text="Select disk image"/>
		</StackPanel>

		<Border Grid.Row="1" Classes="card" Padding="4">
			<ListBox Name="lstFiles" SelectionMode="AlwaysSelected"
			         Background="Transparent"
			         KeyDown="ListBox_KeyDown"
			         ItemsSource="{Binding files}"
			         DoubleTapped="lstFiles_DoubleTapped">
			</ListBox>
		</Border>

		<StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0" Spacing="8" HorizontalAlignment="Right">
			<Button Classes="accent" Click="InsertDisk_Click">Insert disk</Button>
			<Button Click="Cancel_Click">Cancel</Button>
		</StackPanel>
	</Grid>
</Window>
