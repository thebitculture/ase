<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:svg="clr-namespace:Avalonia.Svg;assembly=Svg.Controls.Avalonia"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		mc:Ignorable="d"
        xmlns:local="using:ASE"
        x:Class="ASE.FileList"
        x:DataType="local:FileList"
        Title="File List"
        CanResize="False"
		WindowStartupLocation="CenterScreen"
		UseLayoutRounding="True"
        Width="400" Height="350"
        >

    <StackPanel Orientation="Vertical" Margin="0,10,0,0" Spacing="6">

        <StackPanel Orientation="Horizontal">
            <Svg Path="avares://ASE/Assets/Icons/disk.svg"
			    Width="18" Height="18"
			    Margin="10,0,4,0"
			    VerticalAlignment="Center"/>
            <Label>Select disk image</Label>
        </StackPanel>

		<Grid RowDefinitions="*" ColumnDefinitions="*" Height="240" Margin="8">
		  <ListBox Name="lstFiles" SelectionMode="AlwaysSelected"
                   KeyDown="ListBox_KeyDown"
				   ItemsSource="{Binding files}"
				   DoubleTapped="lstFiles_DoubleTapped">
		  </ListBox>
		</Grid>
		<StackPanel Orientation="Horizontal" Margin="0,0,20,10" Spacing="8" HorizontalAlignment="Right">
			<Button Click="InsertDisk_Click">Insert disk</Button>
			<Button Click="Cancel_Click">Cancel</Button>
		</StackPanel>
    </StackPanel>
</Window>
