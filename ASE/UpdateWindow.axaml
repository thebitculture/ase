<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:svg="clr-namespace:Avalonia.Svg;assembly=Svg.Controls.Avalonia"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		mc:Ignorable="d"
        xmlns:local="clr-namespace:ASE"
        x:Class="ASE.UpdateWindow"
        Title="ASE update available"
		CanResize="False"
		WindowStartupLocation="CenterOwner"
		UseLayoutRounding="True"
		Width="500" Height="380">

	<Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24,20">

		<StackPanel Grid.Row="0" HorizontalAlignment="Center" Spacing="6">
			<Image Source="./Assets/logo.png" Height="52"/>
			<TextBlock Name="TextNewVersion" HorizontalAlignment="Center" FontWeight="SemiBold"
					   Foreground="{DynamicResource AccentTextBrush}">⭐ New version {{version}} available! ⭐</TextBlock>
			<TextBlock Name="TextCurrentVersion" HorizontalAlignment="Center" Opacity="0.7">You are using version {{version}}</TextBlock>
		</StackPanel>

		<Border Grid.Row="1" Classes="card" Margin="0,16,0,0">
			<StackPanel Spacing="6">
				<TextBlock Name="TextReleaseName" Classes="section" IsVisible="False" TextWrapping="Wrap"/>
				<TextBlock Name="TextPublished" Opacity="0.7"/>
				<StackPanel Orientation="Horizontal" Spacing="8">
					<Svg Path="avares://ASE/Assets/Icons/github.svg" Width="18" Height="18" VerticalAlignment="Center"/>
					<HyperlinkButton Name="LinkRelease" Click="OpenRelease_Click" Padding="0" VerticalAlignment="Center"/>
				</StackPanel>
			</StackPanel>
		</Border>

		<TextBlock Grid.Row="2" TextWrapping="Wrap" Opacity="0.7" VerticalAlignment="Center" Margin="0,14,0,0"
				   Text="Update opens the download page in your browser and the emulator carries on running, so you can install the new version whenever it suits you."/>

		<Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" Margin="0,16,0,0" VerticalAlignment="Center">
			<StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
				<ToggleSwitch Name="SwitchCheckForUpdates" OnContent="" OffContent="" VerticalAlignment="Center"/>
				<TextBlock Text="Check for updates" VerticalAlignment="Center"/>
			</StackPanel>
			<Button Grid.Column="1" Content="Continue" Width="90" Margin="0,0,8,0"
					HorizontalContentAlignment="Center"
					Name="ButtonContinue" Click="ButtonContinue_Click"/>
			<Button Grid.Column="2" Classes="accent" Content="Update" Width="90"
					HorizontalContentAlignment="Center"
					Name="ButtonUpdate" Click="ButtonUpdate_Click"/>
		</Grid>
	</Grid>

</Window>
